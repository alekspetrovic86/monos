<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <block name="blocks" default-type="cards-badges">
        <types>
            <type name="cards-badges">
                <meta>
                    <title lang="en">Cards Badges</title>
                </meta>

                <properties>
                    <property name="mode" type="single_select">
                        <meta>
                            <title lang="en">Mode</title>
                        </meta>
                        <params>
                            <param name="values" type="collection">
                                <param name="light" type="collection">
                                    <param name="title" value="Light"/>
                                </param>
                                <param name="dark" type="collection">
                                    <param name="title" value="Dark"/>
                                </param>
                            </param>
                        </params>
                    </property>

                    <property name="title" type="text_line">
                        <meta>
                            <title lang="en">Title</title>
                        </meta>
                    </property>

                    <property name="description" type="text_editor">
                        <meta>
                            <title lang="en">Description</title>
                        </meta>
                    </property>

                    <block name="cards" default-type="card" minOccurs="0">
                        <meta>
                            <title lang="en">Cards</title>
                        </meta>
                        <types>
                            <type name="card">
                                <meta>
                                    <title lang="en">Card</title>
                                </meta>
                                <properties>
                                    <property name="mini_title" type="text_line">
                                        <meta>
                                            <title lang="en">Mini Title (badge label)</title>
                                        </meta>
                                    </property>

                                    <property name="title" type="text_line">
                                        <meta>
                                            <title lang="en">Title</title>
                                        </meta>
                                    </property>

                                    <property name="description" type="text_editor">
                                        <meta>
                                            <title lang="en">Description</title>
                                        </meta>
                                    </property>

                                    <block name="badges" default-type="badge" minOccurs="0">
                                        <meta>
                                            <title lang="en">Badges</title>
                                        </meta>
                                        <types>
                                            <type name="badge">
                                                <meta>
                                                    <title lang="en">Badge</title>
                                                </meta>
                                                <properties>
                                                    <property name="text" type="text_line">
                                                        <meta>
                                                            <title lang="en">Text</title>
                                                        </meta>
                                                    </property>
                                                </properties>
                                            </type>
                                        </types>
                                    </block>
                                </properties>
                            </type>
                        </types>
                    </block>
                </properties>
            </type>
        </types>
    </block>
</properties>
