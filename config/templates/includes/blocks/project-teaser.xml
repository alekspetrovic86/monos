<?xml version="1.0" ?>
<!-- project-teaser: stavka liste projekata. Figma F1/F2 (22:75, 12:66), F14/F15 (51:155, 51:174).
     Dva stanja: obična (samo slika + dugi opis) i istaknuta (slika šira, ispod naslov, podnaslov, „Enter"). -->
<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <block name="blocks" default-type="project-teaser">
        <types>
            <type name="project-teaser">
                <meta>
                    <title lang="en">Project</title>
                    <title lang="sr">Projekat</title>
                    <title lang="ja">プロジェクト</title>
                </meta>

                <properties>
                    <property name="image" type="single_media_selection" mandatory="true">
                        <meta>
                            <title lang="en">Image</title>
                            <title lang="sr">Slika</title>
                            <title lang="ja">画像</title>
                            <info_text lang="en">Always visible. Click expands the project.</info_text>
                            <info_text lang="sr">Uvek vidljiva. Klik širi projekat.</info_text>
                        </meta>
                        <params>
                            <param name="types" value="image"/>
                        </params>
                    </property>

                    <property name="title" type="text_editor" mandatory="true">
                        <meta>
                            <title lang="en">Title</title>
                            <title lang="sr">Naslov</title>
                            <title lang="ja">タイトル</title>
                            <info_text lang="en">Shown only while the project is expanded. One empty line starts a new paragraph — that is the gap between the title and the line below it.</info_text>
                            <info_text lang="sr">Vidi se samo kad je projekat raširen. Jedan prazan red počinje novi pasus — to je razmak između naslova i reda ispod njega.</info_text>
                        </meta>
                    </property>

                    <property name="description" type="text_editor">
                        <meta>
                            <title lang="en">Description</title>
                            <title lang="sr">Dugi opis</title>
                            <title lang="ja">説明</title>
                            <info_text lang="en">Optional. Stands ABOVE the image, its last line resting on the image top edge; starts with the label (e.g. "1.2") typed here. Leave empty and the image follows the previous one immediately.</info_text>
                            <info_text lang="sr">Opciono. Stoji IZNAD slike, poslednjim redom naslonjen na njen vrh; oznaka (npr. „1.2") se kuca ovde. Ako je prazno, slika dolazi odmah posle prethodne.</info_text>
                        </meta>
                    </property>

                    <property name="link" type="link" mandatory="true">
                        <meta>
                            <title lang="en">Enter link</title>
                            <title lang="sr">„Enter" link</title>
                            <title lang="ja">「Enter」リンク</title>
                            <info_text lang="en">Project page. Reached by "Enter" or by a second click on the expanded image.</info_text>
                            <info_text lang="sr">Stranica projekta. „Enter" ili drugi klik na raširenu sliku.</info_text>
                        </meta>
                    </property>
                </properties>
            </type>
        </types>
    </block>
</properties>
