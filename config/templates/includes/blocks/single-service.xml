<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <block name="blocks" default-type="single-service">
        <types>
            <type name="single-service">
                <meta>
                    <title lang="en">Single Service</title>
                </meta>

                <properties>
                    <property name="mode" type="single_select">
                        <meta>
                            <title lang="en">Mode</title>
                        </meta>
                        <params>
                            <param name="values" type="collection">
                                <param name="dark" type="collection">
                                    <param name="title" value="Dark"/>
                                </param>
                                <param name="light" type="collection">
                                    <param name="title" value="Light"/>
                                </param>
                            </param>
                        </params>
                    </property>

                    <property name="isReverse" type="checkbox">
                        <meta>
                            <title lang="en">Reverse layout</title>
                        </meta>
                        <params>
                            <param name="type" value="toggler"/>
                            <param name="default_value" value="false"/>
                        </params>
                    </property>

                    <property name="withBorders" type="checkbox">
                        <meta>
                            <title lang="en">Show top/bottom borders (xl)</title>
                        </meta>
                        <params>
                            <param name="type" value="toggler"/>
                            <param name="default_value" value="false"/>
                        </params>
                    </property>

                    <property name="title" type="text_line">
                        <meta>
                            <title lang="en">Title</title>
                            <info_text lang="en">Use | to add a superscript badge</info_text>
                        </meta>
                    </property>

                    <property name="subtitle" type="text_line">
                        <meta>
                            <title lang="en">Subtitle</title>
                        </meta>
                    </property>

                    <property name="description" type="text_editor">
                        <meta>
                            <title lang="en">Description</title>
                        </meta>
                    </property>

                    <property name="quotes_text" type="text_editor">
                        <meta>
                            <title lang="en">Quote</title>
                        </meta>
                    </property>

                    <property name="media_type" type="single_select">
                        <meta>
                            <title lang="en">Visual</title>
                        </meta>
                        <params>
                            <param name="values" type="collection">
                                <param name="image" type="collection">
                                    <param name="title" value="Image"/>
                                </param>
                                <param name="art" type="collection">
                                    <param name="title" value="Art (animated ring)"/>
                                </param>
                                <param name="dev" type="collection">
                                    <param name="title" value="Dev (orbital nodes)"/>
                                </param>
                                <param name="ai" type="collection">
                                    <param name="title" value="AI (neural network)"/>
                                </param>
                            </param>
                        </params>
                    </property>

                    <property name="image" type="single_media_selection">
                        <meta>
                            <title lang="en">Image</title>
                        </meta>
                    </property>

                    <property name="button_text" type="text_line" colspan="6">
                        <meta>
                            <title lang="en">Button Text</title>
                        </meta>
                    </property>

                    <property name="button_link" type="link" colspan="6">
                        <meta>
                            <title lang="en">Button Link</title>
                        </meta>
                    </property>
                </properties>
            </type>
        </types>
    </block>
</properties>
