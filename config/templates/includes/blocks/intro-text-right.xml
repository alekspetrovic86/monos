<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <block name="blocks" default-type="intro-text-right">
        <types>
            <type name="intro-text-right">
                <meta>
                    <title lang="en">Intro Text Right</title>
                </meta>

                <properties>
                    <property name="mode" type="single_select">
                        <meta>
                            <title lang="en">Mode</title>
                        </meta>
                        <params>
                            <param name="values" type="collection">
                                <param name="dark" type="collection">
                                    <param name="title" value="Dark"/>
                                </param>
                                <param name="light" type="collection">
                                    <param name="title" value="Light"/>
                                </param>
                            </param>
                        </params>
                    </property>

                    <property name="mini_title" type="text_line">
                        <meta>
                            <title lang="en">Mini Title (Label left)</title>
                        </meta>
                    </property>

                    <property name="mini_title_color" type="single_select">
                        <meta>
                            <title lang="en">Mini Title Color</title>
                        </meta>
                        <params>
                            <param name="values" type="collection">
                                <param name="orange" type="collection">
                                    <param name="title" value="Orange (default)"/>
                                </param>
                                <param name="purple" type="collection">
                                    <param name="title" value="Purple"/>
                                </param>
                                <param name="violet" type="collection">
                                    <param name="title" value="Violet"/>
                                </param>
                                <param name="pink" type="collection">
                                    <param name="title" value="Pink"/>
                                </param>
                                <param name="indigo" type="collection">
                                    <param name="title" value="Indigo"/>
                                </param>
                                <param name="amber" type="collection">
                                    <param name="title" value="Amber"/>
                                </param>
                            </param>
                        </params>
                    </property>

                    <property name="title" type="text_line">
                        <meta>
                            <title lang="en">Title</title>
                        </meta>
                    </property>

                    <property name="description" type="text_editor">
                        <meta>
                            <title lang="en">Description</title>
                        </meta>
                    </property>

                    <block name="items" default-type="item" minOccurs="0">
                        <meta>
                            <title lang="en">Items (numbered list)</title>
                        </meta>
                        <types>
                            <type name="item">
                                <meta>
                                    <title lang="en">Item</title>
                                </meta>
                                <properties>
                                    <property name="title" type="text_line">
                                        <meta>
                                            <title lang="en">Title</title>
                                        </meta>
                                    </property>
                                    <property name="text" type="text_editor">
                                        <meta>
                                            <title lang="en">Text</title>
                                        </meta>
                                    </property>
                                </properties>
                            </type>
                        </types>
                    </block>

                    <property name="button_text" type="text_line" colspan="6">
                        <meta>
                            <title lang="en">Button Text</title>
                        </meta>
                    </property>

                    <property name="button_link" type="link" colspan="6">
                        <meta>
                            <title lang="en">Button Link</title>
                        </meta>
                    </property>
                </properties>
            </type>
        </types>
    </block>
</properties>
