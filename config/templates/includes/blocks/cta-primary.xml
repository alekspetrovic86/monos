<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <block name="blocks" default-type="cta-primary">
        <types>
            <type name="cta-primary">
                <meta>
                    <title lang="en">CTA Primary</title>
                </meta>

                <properties>
                    <property name="mode" type="single_select">
                        <meta>
                            <title lang="en">Mode</title>
                        </meta>
                        <params>
                            <param name="values" type="collection">
                                <param name="light" type="collection">
                                    <param name="title" value="Light"/>
                                </param>
                                <param name="dark" type="collection">
                                    <param name="title" value="Dark"/>
                                </param>
                            </param>
                        </params>
                    </property>

                    <property name="bg_variant" type="single_select">
                        <meta>
                            <title lang="en">Background Variant (Light mode only)</title>
                        </meta>
                        <params>
                            <param name="values" type="collection">
                                <param name="1" type="collection">
                                    <param name="title" value="Variant 1 — Base + 3 Blobs"/>
                                </param>
                                <param name="2" type="collection">
                                    <param name="title" value="Variant 2 — Base + 5 Blobs"/>
                                </param>
                                <param name="3" type="collection">
                                    <param name="title" value="Variant 3 — Base + 9 Blobs (Full)"/>
                                </param>
                                <param name="4" type="collection">
                                    <param name="title" value="Variant 4 — Warm Base + 3 Blobs"/>
                                </param>
                                <param name="5" type="collection">
                                    <param name="title" value="Variant 5 — Dark Warm + Overlay"/>
                                </param>
                                <param name="6" type="collection">
                                    <param name="title" value="Variant 6 — Cool Indigo/Violet/Pink"/>
                                </param>
                                <param name="7" type="collection">
                                    <param name="title" value="Variant 7 — Deep Purple/Magenta"/>
                                </param>
                                <param name="8" type="collection">
                                    <param name="title" value="Variant 8 — Golden Amber/Orange"/>
                                </param>
                                <param name="9" type="collection">
                                    <param name="title" value="Variant 9 — Sunset Pink/Orange"/>
                                </param>
                                <param name="10" type="collection">
                                    <param name="title" value="Variant 10 — Full Spectrum"/>
                                </param>
                            </param>
                        </params>
                    </property>

                    <property name="title" type="text_line">
                        <meta>
                            <title lang="en">Title</title>
                        </meta>
                    </property>

                    <property name="description" type="text_editor">
                        <meta>
                            <title lang="en">Description</title>
                        </meta>
                    </property>

                    <property name="button_text" type="text_line" colspan="6">
                        <meta>
                            <title lang="en">Button Text</title>
                        </meta>
                    </property>

                    <property name="button_link" type="link" colspan="6">
                        <meta>
                            <title lang="en">Button Link</title>
                        </meta>
                    </property>

                    <property name="button_text2" type="text_line" colspan="6">
                        <meta>
                            <title lang="en">Button Text 2 (Dark mode)</title>
                        </meta>
                    </property>

                    <property name="button_link2" type="link" colspan="6">
                        <meta>
                            <title lang="en">Button Link 2 (Dark mode)</title>
                        </meta>
                    </property>
                </properties>
            </type>
        </types>
    </block>
</properties>
