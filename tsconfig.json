{
    "compilerOptions": {
        "target": "ES2017",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2017", "DOM", "DOM.Iterable"],
        "strict": false,
        "noEmit": true,
        "allowJs": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "skipLibCheck": true
    },
    "include": [
        "assets/**/*.ts",
        "assets/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "public"
    ]
}
