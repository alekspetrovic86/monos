{% extends 'base.html.twig' %}

{% block content %}
<section class="min-h-screen bg-paper text-ink
                px-[4px] pt-[16px] pb-[116px]
                lg:pl-[2px] lg:pr-[95px] lg:pt-[314px] lg:pb-[80px]">

    <h2 class="u-tracked">Showing {{ hits|length }} results for "{{ query }}"</h2>

    <ul class="mt-4">
        {% for i, hit in hits %}
            <li>
                <a href="{{ hit.document.url }}" class="underline underline-offset-2">
                    {{- hit.document.title -}}
                </a>
            </li>
        {% endfor %}
    </ul>

</section>
{% endblock %}
