<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
    <head>
        <meta charset="utf-8">
        {# Progresivno poboljšanje: `.js` na <html> pre prvog crtanja — bez JS-a meni je otvoren (F2'). #}
        <script>document.documentElement.classList.add('js')</script>
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block meta %}
            {% set _seoBase = extension.seo|default({}) %}
            {% set _pageTitle = _seoBase.title|default(content.title|default('')) %}
            {% set _seo = _seoBase|merge({'title': _pageTitle ? _pageTitle ~ ' | Monos' : 'Monos'}) %}
            {{ include('@SuluWebsite/Extension/seo.html.twig', {
                seo: _seo,
                content: content|default([]),
                localizations: localizations|default([]),
                shadowBaseLocale: shadowBaseLocale|default(),
            }) }}
        {% endblock %}

        {# ── PWA / Browser meta ── #}
        <link rel="manifest" href="/site.webmanifest">
        <meta name="theme-color" content="#000000">

        {# ── Open Graph ── #}
        {% set ogTitle       = extension.seo.title|default(content.title|default('Monos')) %}
        {% set ogDescription = extension.seo.description|default(content.excerpt|default('')) %}
        {% set ogImage       = extension.excerpt.images[0].thumbnails['seo_og']|default('') %}
        {% set ogUrl         = app.request.uri %}
        {% set ogLocale      = app.request.locale|replace({'-': '_'}) %}
        <meta property="og:type"        content="website">
        <meta property="og:site_name"   content="Monos">
        <meta property="og:url"         content="{{ ogUrl }}">
        <meta property="og:title"       content="{{ ogTitle }}">
        <meta property="og:description" content="{{ ogDescription }}">
        <meta property="og:locale"      content="{{ ogLocale }}">
        {% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}

        {# ── Twitter / X Card ── #}
        <meta name="twitter:card"        content="summary_large_image">
        <meta name="twitter:title"       content="{{ ogTitle }}">
        <meta name="twitter:description" content="{{ ogDescription }}">
        {% if ogImage %}<meta name="twitter:image" content="{{ ogImage }}">{% endif %}

        {# ── JSON-LD Organization ── #}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "Monos",
            "url": "{{ app.request.schemeAndHttpHost }}",
            "sameAs": []
        }
        </script>

        {% block style %}
            {{ encore_entry_link_tags('website') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('website') }}
        {% endblock %}
    </head>
    {# menu kontroler je na <body>: header (toggle/nav) i sadržaj (inert pod mobilnim overlayem) su mu targeti. #}
    <body data-controller="menu">
        {% block header %}
            {% include 'includes/header.html.twig' %}
        {% endblock %}

        {# l-container: najviše 1440px, skroz levo; iznad 1440 leva margina (main.scss). #}
        <div data-menu-target="content" class="l-container">
            {% block content %}{% endblock %}
        </div>
    </body>
</html>
