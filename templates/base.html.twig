<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
    <head>
        <meta charset="utf-8">
        {# Progresivno poboljšanje: `.js` na <html> pre prvog crtanja — bez JS-a meni je otvoren (F2'). #}
        <script>document.documentElement.classList.add('js')</script>
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block meta %}
            {% set _seo_base = extension.seo|default({}) %}
            {# Naslov projekta je text_area (prelomi iz urednika) — u <title> prelomi postaju razmaci. #}
            {% set _page_title = _seo_base.title|default(content.title|default(''))|replace({'\n': ' ', '\r': ''}) %}
            {% set _seo = _seo_base|merge({title: _page_title ? _page_title ~ ' | Monos' : 'Monos'}) %}
            {{ include('@SuluWebsite/Extension/seo.html.twig', {
                seo: _seo,
                content: content|default([]),
                localizations: localizations|default([]),
                shadowBaseLocale: shadowBaseLocale|default(),
            }) }}
        {% endblock %}

        {# ── PWA / Browser meta ── #}
        {# Favicon: slovo „M" u Inter 500, crno na belom, bez zaobljenja (Monos nema logo — u Figmi je čist tekst). #}
        <link rel="icon" href="/favicon.ico" sizes="32x32">
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        <link rel="manifest" href="/site.webmanifest">
        <meta name="theme-color" content="#FFFFFF">

        {# ── hreflang x-default ── #}
        {# Sulu-ov SEO dodatak (gore) već ispisuje `alternate` za sr/en/ja i `canonical`. Ne ispisuje
           `x-default` — njime se kaže pretraživaču koju verziju da posluži kad nijedan jezik ne odgovara.
           Srpski je podrazumevani (na korenu), pa on nosi tu ulogu. #}
        {% if localizations.sr.url|default %}
            <link rel="alternate" href="{{ localizations.sr.url }}" hreflang="x-default">
        {% endif %}

        {# ── Open Graph ── #}
        {% set og_title = extension.seo.title|default(content.title|default('Monos'))|replace({'\n': ' ', '\r': ''}) %}
        {% set og_description = extension.seo.description|default(content.excerpt|default('')) %}
        {# Slika za deljenje: prvo excerpt slika same stranice, pa podrazumevana iz settings snippet-a.
           Bez ovog drugog koraka stranica bez excerpt slike deli se BEZ ikakve slike — link na WhatsApp-u
           ili Instagramu ostaje prazan. Podrazumevana se postavlja u adminu, pa ne zavisi od koda. #}
        {% set og_image = extension.excerpt.images[0].thumbnails['seo_og']|default('') %}
        {% if not og_image %}
            {% set _og_settings = sulu_snippet_load_by_area('webspace_settings') %}
            {% set og_image = _og_settings.content.og_image.thumbnails['seo_og']|default('') %}
        {% endif %}
        {% if og_image and og_image starts with '/' %}
            {% set og_image = app.request.schemeAndHttpHost ~ og_image %}
        {% endif %}
        {% set og_url = app.request.uri %}
        {% set og_locale = app.request.locale|replace({'-': '_'}) %}
        <meta property="og:type"        content="website">
        <meta property="og:site_name"   content="Monos">
        <meta property="og:url"         content="{{ og_url }}">
        <meta property="og:title"       content="{{ og_title }}">
        <meta property="og:description" content="{{ og_description }}">
        <meta property="og:locale"      content="{{ og_locale }}">
        {% if og_image %}<meta property="og:image" content="{{ og_image }}">{% endif %}

        {# ── Twitter / X Card ── #}
        <meta name="twitter:card"        content="summary_large_image">
        <meta name="twitter:title"       content="{{ og_title }}">
        <meta name="twitter:description" content="{{ og_description }}">
        {% if og_image %}<meta name="twitter:image" content="{{ og_image }}">{% endif %}

        {# ── JSON-LD Organization ── #}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "Monos",
            "url": "{{ app.request.schemeAndHttpHost }}",
            "sameAs": []
        }
        </script>

        {% block style %}
            {{ encore_entry_link_tags('website') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('website') }}
        {% endblock %}
    </head>
    {# menu kontroler je na <body>: header (toggle/nav) i sadržaj (inert pod mobilnim overlayem) su mu targeti.
       Stranica projekta (F7–F11) nema meni — prazni i `header` i `body_attributes`. #}
    <body {% block body_attributes %}data-controller="menu"{% endblock %}>
        {# Traka učitavanja: 1px na vrhu, puni se tokom Turbo navigacije (loader_controller.ts, .global-loader u main.scss). #}
        <div class="global-loader" data-controller="loader"></div>

        {% block header %}
            {{ include('includes/header.html.twig') }}
        {% endblock %}

        {# l-container: najviše 1440px, skroz levo; iznad 1440 leva margina (main.scss). #}
        <div data-menu-target="content" class="l-container">
            {% block content %}{% endblock %}
        </div>
    </body>
</html>
