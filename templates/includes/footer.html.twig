{# FOOTER #}

{% set footer = footerInfo ?? [] %}

<footer class="border-t border-grey-200 bg-grey-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 md:gap-12 mb-10 md:mb-12">

            {# Brand #}
            <div class="lg:col-span-2">
                <div class="flex items-center space-x-2 mb-3 md:mb-4">
                    <a href="{{ sulu_content_path('/') }}" class="inline-block">
                        <span class="font-bold text-xl md:text-2xl tracking-tight bg-gradient-to-r from-dark-800 to-dark-700 bg-clip-text text-transparent">
                            Monos
                        </span>
                    </a>
                </div>

                {% if footer.footer_text|default %}
                    <p class="text-[15px] md:text-base text-dark-500 mb-5 md:mb-6 max-w-sm leading-relaxed">
                        {{ footer.footer_text }}
                    </p>
                {% endif %}

                <div class="flex space-x-3">
                    {% if footer.x_link|default %}
                        <a href="{{ footer.x_link }}"
                           class="w-10 h-10 rounded-lg bg-dark-800/5 hover:bg-dark-800/10 flex items-center justify-center transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" class="text-dark-700">
                                <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
                            </svg>
                        </a>
                    {% endif %}

                    {% if footer.linkedin_link|default %}
                        <a href="{{ footer.linkedin_link }}"
                           class="w-10 h-10 rounded-lg bg-dark-800/5 hover:bg-dark-800/10 flex items-center justify-center transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" class="text-dark-700">
                                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                                <rect x="2" y="9" width="4" height="12"/>
                                <circle cx="4" cy="4" r="2"/>
                            </svg>
                        </a>
                    {% endif %}

                    {% if footer.mail_link|default %}
                        <a href="{{ footer.mail_link }}"
                           class="w-10 h-10 rounded-lg bg-dark-800/5 hover:bg-dark-800/10 flex items-center justify-center transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" class="text-dark-700">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </a>
                    {% endif %}
                </div>
            </div>

            {# Footer Menu 1 #}
            {% if footer.footerMenu1|default([]) %}
                <div>
                    {% if footer.footer_menu1_title|default %}
                        <h4 class="text-base font-semibold text-dark-800 mb-3 md:mb-4">{{ footer.footer_menu1_title|raw }}</h4>
                    {% endif %}
                    <ul class="space-y-2 md:space-y-3">
                        {% for item in footer.footerMenu1 %}
                            {% if item.link|default or item.title|default %}
                                <li>
                                    <a href="{{ item.link|default('#') }}"
                                    class="text-[15px] md:text-base text-dark-500 hover:text-dark-800 transition-colors">
                                        {{ item.title|raw }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {# Footer Menu 2 #}
            {% if footer.footerMenu2|default([]) %}
                <div>
                    {% if footer.footer_menu2_title|default %}
                        <h4 class="text-base font-semibold text-dark-800 mb-3 md:mb-4">{{ footer.footer_menu2_title|raw }}</h4>
                    {% endif %}
                    <ul class="space-y-2 md:space-y-3">
                        {% for item in footer.footerMenu2 %}
                            {% if item.link|default or item.title|default %}
                                <li>
                                    <a href="{{ item.link|default('#') }}"
                                    class="text-[15px] md:text-base text-dark-500 hover:text-dark-800 transition-colors">
                                        {{ item.title|raw }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {# Footer Menu 3 #}
            {% if footer.footerMenu3|default([]) %}
                <div>
                    {% if footer.footer_menu3_title|default %}
                        <h4 class="text-base font-semibold text-dark-800 mb-3 md:mb-4">{{ footer.footer_menu3_title|raw }}</h4>
                    {% endif %}
                    <ul class="space-y-2 md:space-y-3">
                        {% for item in footer.footerMenu3 %}
                            {% if item.link|default or item.title|default %}
                                <li>
                                    <a href="{{ item.link|default('#') }}"
                                       class="text-[15px] md:text-base text-dark-500 hover:text-dark-800 transition-colors">
                                        {{ item.title|raw }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

        </div>

        {# Bottom bar #}
        <div class="pt-6 md:pt-8 border-t border-grey-200 flex flex-col md:flex-row justify-between items-center space-y-3 md:space-y-0 text-center md:text-left">
            {% if footer.copyright|default %}
                <div class="text-dark-500 text-sm">
                    {{ footer.copyright|raw }}
                </div>
            {% endif %}

            {% if footer.bottom_text|default %}
                <p class="text-dark-500 text-sm">
                    {{ footer.bottom_text }}
                </p>
            {% endif %}
        </div>

    </div>
</footer>
