{# CARDS GRADIENT #}

{% set isDark = content.mode|default('light') == 'dark' %}

{# Gradient pairs cycling per card: violet→pink, pink→orange, orange→amber, amber→purple #}
{% set gradients = [
    'from-violet-500 to-pink-500',
    'from-pink-500 to-orange-500',
    'from-orange-500 to-amber-400',
    'from-amber-400 to-purple-500',
] %}

<section data-controller="cards-gradient"
         data-mode-block="{{ isDark ? 'dark' : 'light' }}"
         class="cards-gradient-section relative py-16 md:py-24 lg:py-32 overflow-hidden {{ isDark ? 'bg-black' : 'bg-grey-50' }}">

    {# Subtle gradient overlay #}
    {% if not isDark %}
        <div class="absolute inset-0 pointer-events-none cards-gradient-overlay--light"></div>
    {% endif %}

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">

        {# Heading #}
        {% if content.title|default or content.description|default %}
            <div class="cards-gradient-heading text-center mb-12 md:mb-16 lg:mb-20">
                {% if content.title|default %}
                    <h2 class="cards-gradient-title text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-1.2px] leading-[1.1] {{ isDark ? 'text-white' : 'text-grey-900' }} mb-4 md:mb-6">
                        {{ content.title }}
                    </h2>
                {% endif %}
                {% if content.description|default %}
                    <div class="cards-gradient-desc text-xl md:text-2xl lg:text-[21px] lg:tracking-[0.2px] {{ isDark ? 'text-grey-450' : 'text-grey-500' }} max-w-2xl mx-auto leading-[1.38]">
                        {{ content.description|raw }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# Cards grid #}
        {% if content.cards|default %}
            <div class="grid md:grid-cols-2 gap-6 md:gap-8">
                {% for card in content.cards %}
                    {% set gradient = gradients[loop.index0 % gradients|length] %}
                    <div class="cards-gradient-card {{ isDark ? 'cards-gradient-card--dark' : 'cards-gradient-card--light' }} group rounded-2xl md:rounded-3xl overflow-hidden flex flex-col transition-all duration-300"
                         style="--card-delay: {{ loop.index0 * 0.1 }}s">

                        {# Gradient top bar — in flow like services, overflow-hidden clips it flush #}
                        <div class="h-[8px] md:h-[10px] w-full flex-shrink-0 bg-gradient-to-r {{ gradient }}"></div>

                        <div class="flex flex-col flex-1 p-8 md:p-10">

                            {% if card.title|default %}
                                <h3 class="cards-gradient-card-title text-2xl md:text-[28px] md:leading-snug font-semibold {{ isDark ? 'text-white' : 'text-grey-900' }} mb-3 md:mb-4">
                                    {{ card.title }}
                                </h3>
                            {% endif %}

                            {% if card.description|default %}
                                <div class="cards-gradient-card-desc text-base md:text-[18px] {{ isDark ? 'text-grey-450' : 'text-grey-500' }} leading-relaxed">
                                    {{ card.description|raw }}
                                </div>
                            {% endif %}

                        </div>

                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
