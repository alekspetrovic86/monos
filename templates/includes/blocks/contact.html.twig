{# CONTACT #}

{% set isDark = content.mode|default('light') == 'dark' %}

<section data-controller="contact"
         data-mode-block="{{ isDark ? 'dark' : 'light' }}"
         class="contact-section relative py-16 md:py-24 lg:py-32 overflow-hidden {{ isDark ? 'bg-black' : 'bg-surface' }}">

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 md:gap-16 lg:gap-20">

            {# Left column: title, description, infos, image #}
            <div class="ct-fade-up">

                {% if content.title|default %}
                    <h2 class="ct-heading-title text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-1.2px] leading-[1.1] {{ isDark ? 'text-white' : 'text-grey-900' }} mb-4 md:mb-6">
                        {{ content.title }}
                    </h2>
                {% endif %}

                {% if content.description|default %}
                    <div class="ct-heading-desc text-base md:text-lg {{ isDark ? 'text-grey-450' : 'text-grey-500' }} mb-10 md:mb-12 leading-relaxed">
                        {{ content.description|raw }}
                    </div>
                {% endif %}

                {# Info items #}
                {% if content.infos|default %}
                    <div class="space-y-6 md:space-y-8 mb-10 md:mb-12">
                        {% for info in content.infos %}
                            <div class="ct-info-item flex items-start space-x-4"
                                 style="--ct-delay: {{ loop.index0 * 0.1 }}s">
                                {% if info.icon|default %}
                                    <div class="ct-icon w-11 h-11 md:w-12 md:h-12 rounded-xl {{ isDark ? 'bg-grey-800' : 'bg-dark-800' }} flex items-center justify-center shrink-0 transition-all duration-300">
                                        <img src="{{ info.icon.url }}" alt="{{ info.icon.title|default('') }}"
                                             class="w-5 h-5 md:w-6 md:h-6 object-contain brightness-0 invert">
                                    </div>
                                {% endif %}
                                <div>
                                    {% if info.title|default %}
                                        <p class="ct-info-label text-xs md:text-sm {{ isDark ? 'text-grey-500' : 'text-grey-500' }} mb-0.5 md:mb-1 uppercase tracking-wide">{{ info.title }}</p>
                                    {% endif %}
                                    {% if info.text|default %}
                                        <p class="ct-info-text text-base md:text-lg {{ isDark ? 'text-white' : 'text-grey-900' }} font-medium">{{ info.text }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Image #}
                {% if content.image|default %}
                    <div class="ct-fade-up relative rounded-2xl md:rounded-3xl overflow-hidden" style="--ct-delay: 0.4s">
                        <img src="{{ content.image.url }}"
                             alt="{{ content.image.title|default('') }}"
                             class="w-full h-auto object-cover">
                    </div>
                {% endif %}

            </div>

            {# Right column: form + bottom text #}
            {% if content.form|default %}
                <div class="ct-fade-up" style="--ct-delay: 0.2s">

                    {% if app.request.get('send') == 'true' %}
                        <div class="ct-success flex items-start gap-3 px-4 py-4 md:px-5 md:py-4 mb-6 rounded-xl md:rounded-2xl bg-green-50 border border-green-200 text-green-800">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 mt-0.5 text-green-500">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="m9 12 2 2 4-4"/>
                            </svg>
                            <div class="text-sm md:text-base font-medium leading-snug">
                                {{ view.form.entity.successText|raw }}
                            </div>
                        </div>
                    {% endif %}

                    {% form_theme content.form 'form/theme.html.twig' %}
                    {{ form_start(content.form, {attr: {class: 'ct-form', novalidate: 'novalidate'}}) }}
                        {{ form_widget(content.form) }}
                    {{ form_end(content.form) }}

                    {% if content.bottom_text|default %}
                        <p class="ct-bottom-text text-xs md:text-sm {{ isDark ? 'text-grey-500' : 'text-grey-500' }} text-center pt-2 mt-5 md:mt-6">{{ content.bottom_text }}</p>
                    {% endif %}
                </div>
            {% endif %}

        </div>
    </div>

</section>
