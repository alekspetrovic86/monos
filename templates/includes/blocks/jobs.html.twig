{# JOBS #}

{% set isDark = content.mode|default('light') == 'dark' %}

{% set badgeGradients = [
    'jobs-badge--1',
    'jobs-badge--2',
    'jobs-badge--3',
    'jobs-badge--4',
] %}

<section data-controller="jobs"
         data-mode-block="{{ isDark ? 'dark' : 'light' }}"
         class="jobs-section relative py-16 md:py-24 lg:py-32 overflow-hidden {{ isDark ? 'bg-black' : 'bg-white' }}">

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">

        {# Heading #}
        {% if content.title|default or content.description|default %}
            <div class="jobs-fade-up text-center mb-12 md:mb-16">
                {% if content.title|default %}
                    <h2 class="jobs-heading-title text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-1.2px] leading-[1.1] {{ isDark ? 'text-white' : 'text-grey-900' }} mb-4 md:mb-6">
                        {{ content.title }}
                    </h2>
                {% endif %}
                {% if content.description|default %}
                    <div class="jobs-heading-desc text-xl md:text-2xl lg:text-[21px] lg:tracking-[0.2px] {{ isDark ? 'text-grey-450' : 'text-grey-500' }} max-w-3xl mx-auto leading-[1.38]">
                        {{ content.description|raw }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# Job list #}
        {% if content.jobs|default %}
            <div class="space-y-6 md:space-y-8">
                {% for job in content.jobs %}
                    {% set badgeClass = badgeGradients[loop.index0 % badgeGradients|length] %}
                    <div class="jobs-card jobs-fade-up group {{ isDark ? 'bg-white/[0.03] backdrop-blur-md border-white/[0.08] hover:bg-white/[0.06] hover:border-white/[0.12] process-card-shadow' : 'bg-white border-grey-200 hover:border-grey-300 hover:shadow-xl hover:shadow-grey-200/50' }} rounded-2xl md:rounded-3xl p-6 md:p-8 border transition-all duration-300"
                         style="--jobs-delay: {{ loop.index0 * 0.05 }}s">

                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 md:gap-6">

                            {# Left: title, badge, text, meta #}
                            <div class="flex-1">

                                <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-3 md:mb-4">
                                    {% if job.title|default %}
                                        <h3 class="jobs-card-title text-xl md:text-2xl lg:text-3xl font-bold {{ isDark ? 'text-white' : 'text-grey-900' }}">
                                            {{ job.title }}
                                        </h3>
                                    {% endif %}
                                    {% if job.badge|default %}
                                        <span class="jobs-badge {{ badgeClass }} inline-flex items-center px-3 py-1.5 text-white rounded-full text-xs md:text-sm font-semibold w-fit">
                                            {{ job.badge }}
                                        </span>
                                    {% endif %}
                                </div>

                                {% if job.text|default %}
                                    <div class="jobs-card-text text-base md:text-lg {{ isDark ? 'text-grey-450' : 'text-grey-500' }} mb-4 md:mb-5 leading-relaxed">
                                        {{ job.text|raw }}
                                    </div>
                                {% endif %}

                                {# Meta: location + time #}
                                {% if job.location|default or job.time|default %}
                                    <div class="jobs-card-meta flex flex-wrap gap-4 md:gap-5 text-sm md:text-base {{ isDark ? 'text-grey-500' : 'text-grey-500' }}">
                                        {% if job.location|default %}
                                            <div class="flex items-center space-x-2">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-5 md:h-5 shrink-0">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                                                </svg>
                                                <span>{{ job.location }}</span>
                                            </div>
                                        {% endif %}
                                        {% if job.time|default %}
                                            <div class="flex items-center space-x-2">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-5 md:h-5 shrink-0">
                                                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                                </svg>
                                                <span>{{ job.time }}</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}

                            </div>

                            {# Right: Apply button #}
                            {% if job.button_text|default %}
                                <a href="{{ job.button_link|default('#') }}"
                                   class="jobs-apply-btn group/btn px-6 md:px-8 py-3 md:py-3.5 {{ isDark ? 'bg-white text-dark-800 hover:bg-white/90 shadow-lg shadow-dark-900/10 hover:shadow-xl hover:shadow-dark-900/20' : 'bg-dark-800 text-white hover:bg-dark-700 shadow-lg shadow-dark-900/10 hover:shadow-xl hover:shadow-dark-900/20' }} rounded-full font-semibold transition-all duration-300 flex items-center justify-center space-x-2 whitespace-nowrap shrink-0">
                                    <span>{{ job.button_text }}</span>
                                    <div class="relative w-[18px] h-[18px]">
                                        <svg class="absolute inset-0 transition-all duration-300 group-hover/btn:translate-x-1 group-hover/btn:opacity-0"
                                             xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="9 18 15 12 9 6"/>
                                        </svg>
                                        <svg class="absolute inset-0 transition-all duration-300 opacity-0 -translate-x-1 group-hover/btn:opacity-100 group-hover/btn:translate-x-1"
                                             xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                                        </svg>
                                    </div>
                                </a>
                            {% endif %}

                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>

</section>
