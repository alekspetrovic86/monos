{# INTRO #}

{% set isDark = content.mode|default('light') == 'dark' %}

<section data-controller="intro" data-mode-block="{{ isDark ? 'dark' : 'light' }}" class="relative py-16 md:py-24 lg:py-32 {{ isDark ? 'bg-black' : 'bg-white' }} overflow-hidden">

    {% if isDark %}
        {# Subtle grid overlay (dark only) #}
        <div class="absolute inset-0 opacity-[0.03]"
             style="background-image:linear-gradient(rgba(255,255,255,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.05) 1px,transparent 1px);background-size:60px 60px"></div>
    {% endif %}

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
        <div class="grid lg:grid-cols-2 gap-10 md:gap-16 lg:gap-20 items-start">

            {# Left: title + subtitle #}
            <div class="intro-left">
                {% if content.title|default %}
                    {% set titleParts = content.title|split('|') %}
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-1.2px] leading-[1.1] {{ isDark ? 'text-white' : 'text-grey-900' }} mb-3 md:mb-4">
                        {{ titleParts[0] }}{% if titleParts[1] is defined %}<span class="block">{{ titleParts[1] }}</span>{% endif %}
                    </h2>
                {% endif %}

                {% if content.subtitle|default %}
                    <p class="art-subtitle text-lg md:text-xl lg:text-2xl font-semibold {{ isDark ? 'text-white/90' : 'text-grey-700' }}">
                        {{ content.subtitle }}
                    </p>
                {% endif %}
            </div>

            {# Right: description + button #}
            <div class="intro-right">

                {% if content.description|default %}
                    <div class="intro-description {{ isDark ? 'intro-description--dark' : 'intro-description--light' }} text-xl md:text-2xl lg:text-[21px] lg:tracking-[0.2px] {{ isDark ? 'text-grey-450' : 'text-grey-500' }} mb-8 md:mb-10 leading-[1.38] lg:pt-[12px]">
                        {{ content.description|raw }}
                    </div>
                {% endif %}

                {% if content.quotes_text|default %}
                    <div class="art-quote relative pl-6 md:pl-8 border-l-4 {{ isDark ? 'border-white' : 'border-grey-900' }} py-2 mb-8 md:mb-10">
                        <div class="text-lg md:text-xl lg:text-2xl font-medium {{ isDark ? 'text-white' : 'text-grey-900' }} italic leading-relaxed">
                            {{ content.quotes_text|raw }}
                        </div>
                    </div>
                {% endif %}

                {% if content.button_text|default %}
                    <a href="{{ content.button_link|default('#') }}"
                       class="intro-cta-btn group inline-flex items-center space-x-2 {{ isDark ? 'text-white' : 'text-grey-900' }} font-semibold transition-colors duration-300 text-[15px] md:text-base">
                        <span>{{ content.button_text }}</span>
                        <div class="relative w-4 h-4 md:w-[18px] md:h-[18px]">
                            <svg class="icon-chevron absolute inset-0 w-4 h-4 md:w-[18px] md:h-[18px]"
                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                            <svg class="icon-arrow absolute inset-0 w-4 h-4 md:w-[18px] md:h-[18px]"
                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                            </svg>
                        </div>
                    </a>
                {% endif %}

            </div>

        </div>
    </div>

</section>
