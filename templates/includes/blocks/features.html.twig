{# FEATURES #}

{% set isDark = content.mode|default('light') == 'dark' %}

{% set iconGradients = [
    'feat-icon--1',
    'feat-icon--2',
    'feat-icon--3',
    'feat-icon--4',
] %}

<section data-controller="features"
         data-mode-block="{{ isDark ? 'dark' : 'light' }}"
         class="features-section relative py-16 md:py-24 lg:py-32 overflow-hidden {{ isDark ? 'bg-black' : 'bg-white' }}">

    {# Gradient overlay #}
    {# <div class="absolute inset-0 {{ isDark ? 'bg-gradient-to-b from-violet-500/5 via-transparent to-orange-500/5' : 'bg-gradient-to-b from-purple-500/5 via-transparent to-orange-500/5' }} pointer-events-none"></div> #}

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">

        {# Heading #}
        {% if content.title|default or content.description|default %}
            <div class="feat-fade-up text-center mb-12 md:mb-16">
                {% if content.title|default %}
                    <h2 class="feat-heading-title text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-1.2px] leading-[1.1] {{ isDark ? 'text-white' : 'text-grey-900' }} mb-4 md:mb-6">
                        {{ content.title }}
                    </h2>
                {% endif %}
                {% if content.description|default %}
                    <div class="feat-heading-desc text-xl md:text-2xl lg:text-[21px] lg:tracking-[0.2px] {{ isDark ? 'text-grey-450' : 'text-grey-500' }} max-w-3xl mx-auto leading-[1.38]">
                        {{ content.description|raw }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# Cards grid #}
        {% if content.cards|default %}
            <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6 md:gap-8">
                {% for card in content.cards %}
                    {% set iconClass = iconGradients[loop.index0 % iconGradients|length] %}
                    <div class="feat-card feat-fade-up group {{ isDark ? 'bg-black border-grey-700 hover:border-grey-600 process-card-shadow' : 'bg-white border-grey-200 hover:border-grey-300 process-card-shadow--light' }} rounded-2xl md:rounded-3xl p-6 md:p-8 border transition-all duration-700 ease-out hover:-translate-y-1 text-center"
                         style="--feat-delay: {{ loop.index0 * 0.1 }}s">

                        {% if card.icon|default %}
                            <div class="feat-icon-wrap {{ iconClass }} w-14 h-14 md:w-16 md:h-16 rounded-xl md:rounded-2xl flex items-center justify-center mx-auto mb-5 md:mb-6 transition-transform duration-300">
                                <img src="{{ card.icon.url }}" alt="{{ card.icon.title|default('') }}"
                                     class="w-7 h-7 md:w-8 md:h-8 object-contain brightness-0 invert">
                            </div>
                        {% endif %}

                        {% if card.title|default %}
                            <h3 class="feat-card-title text-xl md:text-2xl font-bold {{ isDark ? 'text-white' : 'text-grey-900' }} min-h-[3.5rem] md:min-h-[4rem] mb-3">
                                {{ card.title }}
                            </h3>
                        {% endif %}

                        {% if card.text|default %}
                            <div class="feat-card-text text-base md:text-lg {{ isDark ? 'text-grey-450' : 'text-grey-500' }} leading-relaxed">
                                {{ card.text|raw }}
                            </div>
                        {% endif %}

                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>

</section>
