{# OUR PROCESS #}

{% set isDark = content.mode|default('light') == 'dark' %}

<section data-controller="our-process"
         data-mode-block="{{ isDark ? 'dark' : 'light' }}"
         class="relative overflow-hidden {{ isDark ? 'bg-black' : 'bg-white' }}">

    {# Dot grid overlay #}
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image:radial-gradient(circle,{{ isDark ? 'rgba(255,255,255,0.15)' : 'rgba(0,0,0,0.4)' }} 1px,transparent 1px);background-size:40px 40px"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
        <div class="{{ content.reduceSpaceTop ? 'pb-20 md:pb-32 lg:pb-40' : 'py-20 md:py-32 lg:py-40' }} xl:border-t xl:border-b {{ isDark ? 'xl:border-grey-700' : 'xl:border-grey-200' }}">
            {# Heading #}
            {% if content.title|default or content.description|default %}
                <div class="process-heading mb-10 md:mb-12 lg:mb-16">
                    {% if content.title|default %}
                        <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-1.2px] leading-[1.1] {{ isDark ? 'text-white' : 'text-grey-900' }} mb-3 md:mb-4">
                            {{ content.title }}
                        </h2>
                    {% endif %}
                    {% if content.description|default %}
                        <div class="process-description text-xl md:text-2xl lg:text-[21px] lg:tracking-[0.2px] {{ isDark ? 'text-grey-450' : 'text-grey-500' }} max-w-3xl leading-[1.38]">
                            {{ content.description|raw }}
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# Cards grid #}
            {% if content.items|default %}
                <div class="relative">
                    {% if not isDark %}
                        {# Static colour mist behind cards #}
                        {# <div class="process-cards-mist absolute inset-0 -z-10 pointer-events-none"></div> #}
                    {% endif %}
                <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8">
                    {% for item in content.items %}
                        {% set idx = loop.index0 %}
                        {% set isLast = loop.last %}

                        {# Cycle through accent colors: violet, purple, pink, orange #}
                        {% set colors = ['violet', 'purple', 'pink', 'orange'] %}
                        {% set color = colors[idx % 4] %}

                        <div class="process-card group relative" data-process-index="{{ idx }}">
                            <div class="relative h-full {{ isDark ? 'bg-white/[0.03] backdrop-blur-md border border-white/[0.08] hover:bg-white/[0.06] hover:border-white/[0.12] process-card-shadow' : 'bg-white border border-grey-200 hover:border-grey-300 process-card-shadow--light' }} rounded-2xl md:rounded-3xl p-8 lg:p-10 transition-all duration-700 ease-out">

                                {# Hover inner glow #}
                                <div class="absolute inset-0 rounded-2xl md:rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none process-inner-glow-{{ color }}{{ isDark ? '' : '--light' }}"></div>

                                <div class="relative">
                                    {# Step number #}
                                    <div class="mb-8">
                                        <span class="text-5xl lg:text-6xl font-bold tracking-tighter inline-block process-number-{{ color }}{{ isDark ? '' : '--light' }}">
                                            {{ '%02d'|format(loop.index) }}
                                        </span>
                                    </div>

                                    {# Title #}
                                    {% if item.title|default %}
                                        <h3 class="text-2xl lg:text-3xl font-bold {{ isDark ? 'text-white' : 'text-grey-900' }} mb-4 tracking-tight leading-tight">
                                            {{ item.title }}
                                        </h3>
                                    {% endif %}

                                    {# Text #}
                                    {% if item.text|default %}
                                        <div class="text-base lg:text-lg {{ isDark ? 'text-grey-450' : 'text-grey-500' }} leading-relaxed">
                                            {{ item.text|raw }}
                                        </div>
                                    {% endif %}

                                    {# Arrow connector — desktop only, hidden on last item #}
                                    {% if not isLast %}
                                        <div class="process-arrow hidden lg:block absolute top-1/2 -translate-y-1/2 {{ isDark ? 'text-white/10 group-hover:text-white/20' : 'text-grey-300 group-hover:text-grey-500' }} transition-colors duration-500">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                                            </svg>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            {# Ambient glow #}
                            <div class="absolute -inset-4 rounded-2xl md:rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none -z-10 process-ambient-glow-{{ color }}"></div>
                        </div>
                    {% endfor %}
                </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>
