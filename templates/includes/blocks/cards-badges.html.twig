{# CARDS BADGES #}

{% set isDark = content.mode|default('light') == 'dark' %}

{# Gradient pairs cycling per card: violet→pink, pink→orange, orange→amber, amber→purple #}
{% set gradients = [
    ['#8B5CF6', '#EC4899'],
    ['#EC4899', '#F97316'],
    ['#F97316', '#FBBF24'],
    ['#FBBF24', '#A855F7'],
] %}

<section data-controller="cards-badges"
         data-mode-block="{{ isDark ? 'dark' : 'light' }}"
         class="cards-badges-section relative py-16 md:py-24 lg:py-32 {{ isDark ? 'bg-black' : 'bg-grey-50' }}">

    <div class="max-w-7xl mx-auto px-6 lg:px-8">

        {# Heading #}
        {% if content.title|default or content.description|default %}
            <div class="cb-heading text-center mb-12 md:mb-16">
                {% if content.title|default %}
                    <h2 class="cb-heading-title text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-1.2px] leading-[1.1] {{ isDark ? 'text-white' : 'text-grey-900' }} mb-4 md:mb-6">
                        {{ content.title }}
                    </h2>
                {% endif %}
                {% if content.description|default %}
                    <div class="cb-heading-desc text-xl md:text-2xl lg:text-[21px] lg:tracking-[0.2px] {{ isDark ? 'text-grey-450' : 'text-grey-500' }} max-w-3xl mx-auto leading-[1.38]">
                        {{ content.description|raw }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# Cards grid #}
        {% if content.cards|default %}
            <div class="grid md:grid-cols-2 gap-6 md:gap-8">
                {% for card in content.cards %}
                    {% set g = gradients[loop.index0 % gradients|length] %}
                    <div class="cb-card group relative overflow-hidden rounded-2xl md:rounded-3xl {{ isDark ? 'bg-black border border-grey-700' : 'bg-white border border-dark-100' }} transition-all duration-500"
                         style="--cb-delay: {{ loop.index0 * 0.1 }}s; --cb-from: {{ g[0] }}; --cb-to: {{ g[1] }}">

                        {# Hover gradient overlay #}
                        <div class="cb-card-overlay absolute inset-0 opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none"
                             style="background: linear-gradient(135deg, {{ g[0] }}, {{ g[1] }})"></div>

                        <div class="relative p-6 md:p-8">

                            {# Mini title badge #}
                            {% if card.mini_title|default %}
                                <div class="inline-flex items-center px-4 py-2 text-white rounded-full text-sm font-semibold mb-4 md:mb-5"
                                     style="background: linear-gradient(90deg, {{ g[0] }}, {{ g[1] }})">
                                    {{ card.mini_title }}
                                </div>
                            {% endif %}

                            {# Title #}
                            {% if card.title|default %}
                                <h3 class="cb-card-title text-2xl md:text-[28px] md:leading-snug font-semibold {{ isDark ? 'text-white' : 'text-grey-900' }} mb-3 md:mb-4">
                                    {{ card.title }}
                                </h3>
                            {% endif %}

                            {# Description #}
                            {% if card.description|default %}
                                <div class="cb-card-desc text-base md:text-[18px] {{ isDark ? 'text-grey-450' : 'text-grey-500' }} leading-relaxed mb-5 md:mb-6 min-h-[calc(1.625*3*1rem)]" style="min-height: calc(1.625 * 3 * 1em)">
                                    {{ card.description|raw }}
                                </div>
                            {% endif %}

                            {# Badges #}
                            {% if card.badges|default %}
                                <div class="flex flex-wrap gap-2">
                                    {% for badge in card.badges %}
                                        {% if badge.text|default %}
                                            <span class="cb-badge px-3 py-1 rounded-full text-sm font-medium {{ isDark ? 'bg-grey-800 text-grey-300' : 'bg-grey-100 text-grey-700' }}">
                                                {{ badge.text }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}

                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
