{# SINGLE JOB #}

{% set isDark = content.mode|default('light') == 'dark' %}

<section data-controller="single-job"
         data-mode-block="{{ isDark ? 'dark' : 'light' }}"
         class="sjb-section relative py-16 md:py-24 lg:py-32 overflow-x-hidden {{ isDark ? 'bg-black' : 'bg-white' }}">

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid xl:grid-cols-3 gap-12 xl:gap-16">

            {# ── Left column: description (2/3 width) ── #}
            <div class="xl:col-span-2 min-w-0">

                {% if content.description|default %}
                    <div class="sjb-description sjb-fade-up">
                        {{ content.description|raw }}
                    </div>
                {% endif %}

            </div>

            {# ── Right column: sticky form (1/3 width) ── #}
            {% if content.form|default %}
                <div class="xl:col-span-1 min-w-0">
                    <div class="xl:sticky xl:top-24 sjb-fade-up" style="--sjb-delay: 0.2s">
                        <div class="sjb-card rounded-3xl p-8 border {{ isDark ? 'bg-white/[0.03] backdrop-blur-md border-white/[0.08] process-card-shadow' : 'bg-surface border-grey-200' }}">

                            {# Success message #}
                            {% if app.request.get('send') == 'true' %}
                                <div class="text-center space-y-4 py-4">
                                    <div class="w-14 h-14 rounded-full {{ isDark ? 'bg-white' : 'bg-dark-800' }} flex items-center justify-center mx-auto">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
                                             fill="none" stroke="{{ isDark ? '#111827' : 'white' }}" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
                                            <path d="m9 12 2 2 4-4"/>
                                        </svg>
                                    </div>
                                    <h3 class="sjb-success-title text-xl font-bold {{ isDark ? 'text-white' : 'text-grey-900' }}">
                                        {{ view.form.entity.successText|default('Application Submitted!')|raw }}
                                    </h3>
                                    <p class="sjb-success-text text-sm leading-relaxed {{ isDark ? 'text-grey-450' : 'text-grey-500' }}">
                                        {{ 'job.application_success_detail'|trans }}
                                    </p>
                                </div>
                            {% else %}

                                {% if content.form_title|default %}
                                    <h3 class="sjb-form-title text-2xl font-bold mb-6 {{ isDark ? 'text-white' : 'text-grey-900' }}">
                                        {{ content.form_title }}
                                    </h3>
                                {% endif %}

                                {% form_theme content.form 'form/theme.html.twig' %}
                                {{ form_start(content.form, {attr: {class: 'ct-form', novalidate: 'novalidate'}}) }}
                                    {{ form_widget(content.form) }}
                                {{ form_end(content.form) }}

                                {% if content.bottom_form_text|default %}
                                    <p class="ct-bottom-text text-xs text-grey-500 mt-4 text-center">{{ content.bottom_form_text }}</p>
                                {% endif %}

                            {% endif %}

                        </div>
                    </div>
                </div>
            {% endif %}

        </div>
    </div>

</section>
