{# HERO DEFAULT #}

{% set mode           = content.mode|default('light') %}
{% set variant        = content.bg_variant|default('3') %}
{% set isLeft         = content.alignment|default('center') == 'left' %}
{% set darkTitleColor = content.dark_title_color|default('gradient') %}

<div data-controller="hero-default" data-mode-block="{{ mode }}">

{# ── DARK VERSION ────────────────────────────────────────────────────── #}

<section data-theme-version="dark" data-title-color="{{ darkTitleColor }}" {{ mode != 'dark' ? 'style="display:none"' : '' }} class="hero-default-dark relative py-16 md:py-28 lg:py-32 overflow-hidden mt-[80px]">

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 {{ isLeft ? 'text-left' : 'text-center' }}">
        <div class="hero-default-content space-y-6">

            {% if content.back_link_text|default %}
                <div class="{{ isLeft ? '' : 'flex justify-center' }}">
                    <a href="{{ content.back_link_url|default('#') }}"
                       class="inline-flex items-center space-x-2 text-white/90 hover:text-white transition-colors group">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="w-5 h-5 group-hover:-translate-x-1 transition-transform">
                            <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
                        </svg>
                        <span class="font-semibold">{{ content.back_link_text }}</span>
                    </a>
                </div>
            {% endif %}

            {% if content.mini_title|default %}
                <div class="{{ isLeft ? '' : 'flex justify-center' }}">
                    <span class="inline-flex items-center pr-4 py-2 text-grey-500 text-sm font-semibold">
                        {{ content.mini_title }}
                    </span>
                </div>
            {% endif %}

            {% if content.title|default %}
                {% set titleParts = content.title|split('|') %}
                <h1 class="text-5xl md:text-7xl font-bold">
                    <span class="hero-default-dark-title">{{ titleParts[0] }}{% if titleParts[1] is defined %}<sup class="text-2xl md:text-4xl font-normal align-super ml-1 -top-1 md:-top-1 lg:-top-2">{{ titleParts[1] }}</sup>{% endif %}</span>
                </h1>
            {% endif %}

            {% if content.description|default %}
                <div class="text-xl md:text-2xl text-white {{ isLeft ? 'max-w-2xl' : 'max-w-3xl mx-auto' }}">
                    {{ content.description|raw }}
                </div>
            {% endif %}

            {% if content.button_text|default or content.button_text2|default %}
                <div class="flex flex-col sm:flex-row gap-4 pt-2 {{ isLeft ? 'justify-start' : 'justify-center' }}">

                    {% if content.button_text|default %}
                        <a href="{{ content.button_link|default('#') }}"
                           class="hero-default-btn-primary group px-6 py-3.5 md:px-8 md:py-4 bg-white text-gray-900 rounded-full font-semibold transition-all duration-300 flex items-center justify-center space-x-2 min-h-[44px] text-[15px] md:text-base">
                            <span>{{ content.button_text }}</span>
                            <div class="relative w-[18px] h-[18px] md:w-5 md:h-5">
                                <svg class="icon-chevron absolute inset-0 w-[18px] h-[18px] md:w-5 md:h-5"
                                     xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"/>
                                </svg>
                                <svg class="icon-arrow absolute inset-0 w-[18px] h-[18px] md:w-5 md:h-5"
                                     xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                                </svg>
                            </div>
                        </a>
                    {% endif %}

                    {% if content.button_text2|default %}
                        <a href="{{ content.button_link2|default('#') }}"
                           class="inline-flex items-center justify-center px-6 py-3.5 md:px-8 md:py-4 bg-transparent text-white border border-grey-700 rounded-full font-semibold transition-all duration-300 min-h-[44px] text-[15px] md:text-base">
                            {{ content.button_text2 }}
                        </a>
                    {% endif %}

                </div>
            {% endif %}

            {% if content.bullets|default %}
                <div class="flex flex-wrap gap-6 text-white/90 text-base md:text-lg {{ isLeft ? '' : 'justify-center' }}">
                    {% for bullet in content.bullets %}
                        <div class="flex items-center space-x-2">
                            {% if bullet.icon|default %}
                                <img src="{{ bullet.icon.url }}" alt="{{ bullet.icon.title|default('') }}"
                                     class="w-5 h-5 object-contain brightness-0 invert shrink-0">
                            {% endif %}
                            {% if bullet.text|default %}
                                <span>{{ bullet.text }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </div>

</section>

{# ── LIGHT VERSION ───────────────────────────────────────────────────── #}

<section data-theme-version="light" {{ mode != 'light' ? 'style="display:none"' : '' }} class="hero-default relative py-16 md:py-28 lg:py-32 overflow-hidden mt-[80px]">

    {# Animated Gradient Background #}
    <div class="hero-default-bg-container absolute inset-0 overflow-hidden {{ variant == '5' ? 'hero-default-bg--v5' : 'bg-surface' }}">

        {# ── Variant 5: dark warm base + animated overlay ── #}
        {% if variant == '5' %}

            <div class="hero-default-base hero-default-base--v5 absolute inset-0 opacity-70"></div>

            {# Blob 1 — Amber/Pink #}
            <div class="absolute opacity-70 blur-[120px]"
                 style="top:-20%; left:-10%; width:160%; height:160%;
                        background: radial-gradient(circle at center, rgba(251,191,36,.7) 0%, rgba(236,72,153,.5) 50%, transparent 100%);">
            </div>

            {# Blob 2 — Indigo/Violet #}
            <div class="absolute opacity-60 blur-[130px]"
                 style="bottom:-20%; right:-10%; width:160%; height:160%;
                        background: radial-gradient(ellipse at center, rgba(99,102,241,.6) 0%, rgba(139,92,246,.45) 40%, rgba(236,72,153,.3) 70%, transparent 100%);">
            </div>

        {# ── Variant 4: warm base (no violet) ── #}
        {% elseif variant == '4' %}

            <div class="hero-default-base hero-default-base--v4 absolute inset-0 opacity-80"></div>

            {# Blob 1 #}
            <div class="hero-default-blob-1 absolute opacity-75 blur-[120px]"
                 style="top:-50%; right:-33%; width:200%; height:200%;
                        background: radial-gradient(circle at center, rgba(236,72,153,.85) 0%, rgba(249,115,22,.75) 25%, rgba(251,191,36,.6) 50%, rgba(253,224,71,.4) 75%, transparent 100%);">
            </div>

            {# Blob 2 #}
            <div class="hero-default-blob-2 absolute opacity-65 blur-[110px]"
                 style="bottom:-33%; left:-25%; width:180%; height:180%;
                        background: radial-gradient(ellipse at center, rgba(249,115,22,.8) 0%, rgba(251,191,36,.65) 30%, rgba(244,114,182,.5) 60%, rgba(253,224,71,.3) 85%, transparent 100%);">
            </div>

            {# Blob 3 #}
            <div class="hero-default-blob-3 absolute opacity-80 blur-[115px]"
                 style="top:33%; right:25%; width:160%; height:160%;
                        background: radial-gradient(circle at center, rgba(251,191,36,.9) 0%, rgba(253,224,71,.8) 20%, rgba(251,146,60,.7) 45%, rgba(236,72,153,.5) 70%, transparent 100%);">
            </div>

        {# ── Variants 6–10: Base + 9 Blobs, different palettes ── #}
        {% elseif variant in ['6','7','8','9','10'] %}

            <div class="hero-default-base hero-default-base--v{{ variant }} absolute inset-0 opacity-80"></div>

            {# Blob 1 #}
            <div class="absolute opacity-75 blur-[120px]"
                 style="top:-50%; right:-33%; width:200%; height:200%;
                        background: {{ {
                            '6':  'radial-gradient(circle at center, rgba(79,70,229,.85) 0%, rgba(139,92,246,.75) 25%, rgba(236,72,153,.6) 50%, rgba(168,85,247,.4) 75%, transparent 100%)',
                            '7':  'radial-gradient(circle at center, rgba(147,51,234,.85) 0%, rgba(236,72,153,.75) 25%, rgba(168,85,247,.6) 50%, rgba(219,39,119,.4) 75%, transparent 100%)',
                            '8':  'radial-gradient(circle at center, rgba(245,158,11,.85) 0%, rgba(249,115,22,.75) 25%, rgba(251,191,36,.6) 50%, rgba(253,224,71,.4) 75%, transparent 100%)',
                            '9':  'radial-gradient(circle at center, rgba(219,39,119,.85) 0%, rgba(236,72,153,.75) 25%, rgba(249,115,22,.6) 50%, rgba(251,191,36,.4) 75%, transparent 100%)',
                            '10': 'radial-gradient(circle at center, rgba(79,70,229,.85) 0%, rgba(139,92,246,.75) 25%, rgba(236,72,153,.6) 50%, rgba(249,115,22,.4) 75%, transparent 100%)',
                        }[variant] }};">
            </div>

            {# Blob 2 #}
            <div class="absolute opacity-65 blur-[110px]"
                 style="bottom:-33%; left:-25%; width:180%; height:180%;
                        background: {{ {
                            '6':  'radial-gradient(ellipse at center, rgba(99,102,241,.8) 0%, rgba(168,85,247,.65) 30%, rgba(236,72,153,.5) 60%, rgba(139,92,246,.3) 85%, transparent 100%)',
                            '7':  'radial-gradient(ellipse at center, rgba(236,72,153,.8) 0%, rgba(147,51,234,.65) 30%, rgba(219,39,119,.5) 60%, rgba(244,114,182,.3) 85%, transparent 100%)',
                            '8':  'radial-gradient(ellipse at center, rgba(249,115,22,.8) 0%, rgba(251,191,36,.65) 30%, rgba(251,146,60,.5) 60%, rgba(253,224,71,.3) 85%, transparent 100%)',
                            '9':  'radial-gradient(ellipse at center, rgba(249,115,22,.8) 0%, rgba(251,191,36,.65) 30%, rgba(244,114,182,.5) 60%, rgba(253,224,71,.3) 85%, transparent 100%)',
                            '10': 'radial-gradient(ellipse at center, rgba(236,72,153,.8) 0%, rgba(249,115,22,.65) 30%, rgba(251,191,36,.5) 60%, rgba(139,92,246,.3) 85%, transparent 100%)',
                        }[variant] }};">
            </div>

            {# Blob 3 #}
            <div class="absolute opacity-80 blur-[115px]"
                 style="top:33%; right:25%; width:160%; height:160%;
                        background: {{ {
                            '6':  'radial-gradient(circle at center, rgba(139,92,246,.9) 0%, rgba(99,102,241,.8) 20%, rgba(168,85,247,.7) 45%, rgba(236,72,153,.5) 70%, transparent 100%)',
                            '7':  'radial-gradient(circle at center, rgba(168,85,247,.9) 0%, rgba(219,39,119,.8) 20%, rgba(147,51,234,.7) 45%, rgba(244,114,182,.5) 70%, transparent 100%)',
                            '8':  'radial-gradient(circle at center, rgba(251,191,36,.9) 0%, rgba(245,158,11,.8) 20%, rgba(251,146,60,.7) 45%, rgba(249,115,22,.5) 70%, transparent 100%)',
                            '9':  'radial-gradient(circle at center, rgba(251,191,36,.9) 0%, rgba(251,146,60,.8) 20%, rgba(249,115,22,.7) 45%, rgba(236,72,153,.5) 70%, transparent 100%)',
                            '10': 'radial-gradient(circle at center, rgba(251,191,36,.9) 0%, rgba(249,115,22,.8) 20%, rgba(236,72,153,.7) 45%, rgba(139,92,246,.5) 70%, transparent 100%)',
                        }[variant] }};">
            </div>

            {# Blob 4 #}
            <div class="absolute opacity-60 blur-[130px]"
                 style="bottom:33%; right:33%; width:170%; height:170%;
                        background: {{ {
                            '6':  'radial-gradient(ellipse at center, rgba(79,70,229,.75) 0%, rgba(99,102,241,.6) 35%, rgba(139,92,246,.45) 65%, rgba(168,85,247,.3) 90%, transparent 100%)',
                            '7':  'radial-gradient(ellipse at center, rgba(126,34,206,.75) 0%, rgba(147,51,234,.6) 35%, rgba(236,72,153,.45) 65%, rgba(168,85,247,.3) 90%, transparent 100%)',
                            '8':  'radial-gradient(ellipse at center, rgba(245,158,11,.75) 0%, rgba(253,224,71,.6) 35%, rgba(251,146,60,.45) 65%, rgba(249,115,22,.3) 90%, transparent 100%)',
                            '9':  'radial-gradient(ellipse at center, rgba(219,39,119,.75) 0%, rgba(249,115,22,.6) 35%, rgba(244,114,182,.45) 65%, rgba(251,146,60,.3) 90%, transparent 100%)',
                            '10': 'radial-gradient(ellipse at center, rgba(79,70,229,.75) 0%, rgba(236,72,153,.6) 35%, rgba(249,115,22,.45) 65%, rgba(251,191,36,.3) 90%, transparent 100%)',
                        }[variant] }};">
            </div>

            {# Blob 5 #}
            <div class="absolute opacity-70 blur-[105px]"
                 style="top:50%; left:25%; width:150%; height:150%;
                        background: {{ {
                            '6':  'radial-gradient(circle at center, rgba(168,85,247,.85) 0%, rgba(139,92,246,.7) 30%, rgba(99,102,241,.55) 60%, rgba(236,72,153,.35) 85%, transparent 100%)',
                            '7':  'radial-gradient(circle at center, rgba(244,114,182,.85) 0%, rgba(236,72,153,.7) 30%, rgba(168,85,247,.55) 60%, rgba(147,51,234,.35) 85%, transparent 100%)',
                            '8':  'radial-gradient(circle at center, rgba(253,224,71,.85) 0%, rgba(251,191,36,.7) 30%, rgba(245,158,11,.55) 60%, rgba(251,146,60,.35) 85%, transparent 100%)',
                            '9':  'radial-gradient(circle at center, rgba(244,114,182,.85) 0%, rgba(251,191,36,.7) 30%, rgba(249,115,22,.55) 60%, rgba(219,39,119,.35) 85%, transparent 100%)',
                            '10': 'radial-gradient(circle at center, rgba(251,191,36,.85) 0%, rgba(236,72,153,.7) 30%, rgba(139,92,246,.55) 60%, rgba(249,115,22,.35) 85%, transparent 100%)',
                        }[variant] }};">
            </div>

            {# Blob 6 #}
            <div class="absolute opacity-55 blur-[100px]"
                 style="bottom:25%; left:33%; width:140%; height:140%;
                        background: {{ {
                            '6':  'radial-gradient(ellipse at center, rgba(99,102,241,.7) 0%, rgba(79,70,229,.6) 30%, rgba(168,85,247,.5) 60%, rgba(139,92,246,.4) 85%, transparent 100%)',
                            '7':  'radial-gradient(ellipse at center, rgba(147,51,234,.7) 0%, rgba(168,85,247,.6) 30%, rgba(219,39,119,.5) 60%, rgba(244,114,182,.4) 85%, transparent 100%)',
                            '8':  'radial-gradient(ellipse at center, rgba(249,115,22,.7) 0%, rgba(245,158,11,.6) 30%, rgba(253,224,71,.5) 60%, rgba(251,146,60,.4) 85%, transparent 100%)',
                            '9':  'radial-gradient(ellipse at center, rgba(249,115,22,.7) 0%, rgba(236,72,153,.6) 30%, rgba(251,191,36,.5) 60%, rgba(244,114,182,.4) 85%, transparent 100%)',
                            '10': 'radial-gradient(ellipse at center, rgba(139,92,246,.7) 0%, rgba(249,115,22,.6) 30%, rgba(251,191,36,.5) 60%, rgba(236,72,153,.4) 85%, transparent 100%)',
                        }[variant] }};">
            </div>

            {# Blob 7 #}
            <div class="absolute opacity-65 blur-[95px]"
                 style="top:25%; left:50%; width:135%; height:135%;
                        background: {{ {
                            '6':  'radial-gradient(circle at center, rgba(139,92,246,.8) 0%, rgba(99,102,241,.7) 25%, rgba(168,85,247,.6) 50%, rgba(79,70,229,.4) 80%, transparent 100%)',
                            '7':  'radial-gradient(circle at center, rgba(219,39,119,.8) 0%, rgba(147,51,234,.7) 25%, rgba(244,114,182,.6) 50%, rgba(168,85,247,.4) 80%, transparent 100%)',
                            '8':  'radial-gradient(circle at center, rgba(245,158,11,.8) 0%, rgba(253,224,71,.7) 25%, rgba(249,115,22,.6) 50%, rgba(251,191,36,.4) 80%, transparent 100%)',
                            '9':  'radial-gradient(circle at center, rgba(219,39,119,.8) 0%, rgba(251,191,36,.7) 25%, rgba(249,115,22,.6) 50%, rgba(244,114,182,.4) 80%, transparent 100%)',
                            '10': 'radial-gradient(circle at center, rgba(249,115,22,.8) 0%, rgba(139,92,246,.7) 25%, rgba(236,72,153,.6) 50%, rgba(251,191,36,.4) 80%, transparent 100%)',
                        }[variant] }};">
            </div>

            {# Blob 8 #}
            <div class="absolute opacity-60 blur-[110px]"
                 style="top:66%; right:50%; width:125%; height:125%;
                        background: {{ {
                            '6':  'radial-gradient(circle at center, rgba(79,70,229,.7) 0%, rgba(139,92,246,.6) 30%, rgba(99,102,241,.5) 55%, rgba(168,85,247,.6) 80%, transparent 100%)',
                            '7':  'radial-gradient(circle at center, rgba(168,85,247,.7) 0%, rgba(236,72,153,.6) 30%, rgba(147,51,234,.5) 55%, rgba(219,39,119,.6) 80%, transparent 100%)',
                            '8':  'radial-gradient(circle at center, rgba(251,146,60,.7) 0%, rgba(249,115,22,.6) 30%, rgba(251,191,36,.5) 55%, rgba(245,158,11,.6) 80%, transparent 100%)',
                            '9':  'radial-gradient(circle at center, rgba(251,146,60,.7) 0%, rgba(219,39,119,.6) 30%, rgba(249,115,22,.5) 55%, rgba(244,114,182,.6) 80%, transparent 100%)',
                            '10': 'radial-gradient(circle at center, rgba(168,85,247,.7) 0%, rgba(251,191,36,.6) 30%, rgba(249,115,22,.5) 55%, rgba(79,70,229,.6) 80%, transparent 100%)',
                        }[variant] }};">
            </div>

            {# Blob 9 #}
            <div class="absolute opacity-70 blur-[120px]"
                 style="bottom:50%; right:25%; width:115%; height:115%;
                        background: {{ {
                            '6':  'radial-gradient(ellipse at center, rgba(168,85,247,.75) 0%, rgba(99,102,241,.65) 35%, rgba(139,92,246,.55) 65%, transparent 100%)',
                            '7':  'radial-gradient(ellipse at center, rgba(244,114,182,.75) 0%, rgba(168,85,247,.65) 35%, rgba(219,39,119,.55) 65%, transparent 100%)',
                            '8':  'radial-gradient(ellipse at center, rgba(253,224,71,.75) 0%, rgba(251,191,36,.65) 35%, rgba(245,158,11,.55) 65%, transparent 100%)',
                            '9':  'radial-gradient(ellipse at center, rgba(244,114,182,.75) 0%, rgba(251,191,36,.65) 35%, rgba(249,115,22,.55) 65%, transparent 100%)',
                            '10': 'radial-gradient(ellipse at center, rgba(253,224,71,.75) 0%, rgba(236,72,153,.65) 35%, rgba(139,92,246,.55) 65%, transparent 100%)',
                        }[variant] }};">
            </div>

        {# ── Variants 1–3: shared violet-orange-pink base ── #}
        {% else %}

            <div class="hero-default-base absolute inset-0 opacity-80"></div>

            {# Blob 1 — shared across V1, V2, V3 #}
            <div class="hero-default-blob-1 absolute opacity-75 blur-[120px]"
                 style="top:-50%; right:-33%; width:200%; height:200%;
                        background: radial-gradient(circle at center, rgba(139,92,246,.85) 0%, rgba(236,72,153,.75) 25%, rgba(249,115,22,.6) 50%, rgba(251,191,36,.4) 75%, transparent 100%);">
            </div>

            {# Blob 2 — shared across V1, V2, V3 #}
            <div class="hero-default-blob-2 absolute opacity-65 blur-[110px]"
                 style="bottom:-33%; left:-25%; width:180%; height:180%;
                        background: radial-gradient(ellipse at center, rgba(236,72,153,.8) 0%, rgba(249,115,22,.65) 30%, rgba(168,85,247,.5) 60%, rgba(251,191,36,.3) 85%, transparent 100%);">
            </div>

            {# Blob 3 — shared across V1, V2, V3 #}
            <div class="hero-default-blob-3 absolute opacity-80 blur-[115px]"
                 style="top:33%; right:25%; width:160%; height:160%;
                        background: radial-gradient(circle at center, rgba(249,115,22,.9) 0%, rgba(251,191,36,.8) 20%, rgba(251,146,60,.7) 45%, rgba(236,72,153,.5) 70%, transparent 100%);">
            </div>

            {# Blobs 4–5 — V2 and V3 only #}
            {% if variant == '2' or variant == '3' %}

                {# Blob 4 #}
                <div class="hero-default-blob-4 absolute opacity-60 blur-[130px]"
                     style="bottom:33%; right:33%; width:170%; height:170%;
                            background: radial-gradient(ellipse at center, rgba(168,85,247,.75) 0%, rgba(219,39,119,.6) 35%, rgba(244,114,182,.45) 65%, rgba(251,146,60,.3) 90%, transparent 100%);">
                </div>

                {# Blob 5 #}
                <div class="hero-default-blob-5 absolute opacity-70 blur-[105px]"
                     style="top:50%; left:25%; width:150%; height:150%;
                            background: radial-gradient(circle at center, rgba(251,191,36,.85) 0%, rgba(253,224,71,.7) 30%, rgba(236,72,153,.55) 60%, rgba(139,92,246,.35) 85%, transparent 100%);">
                </div>

            {% endif %}

            {# Blobs 6–9 — V3 only #}
            {% if variant == '3' %}

                {# Blob 6 #}
                <div class="absolute opacity-55 blur-[100px]"
                     style="bottom:25%; left:33%; width:140%; height:140%;
                            background: radial-gradient(ellipse at center, rgba(168,85,247,.7) 0%, rgba(139,92,246,.6) 30%, rgba(251,191,36,.5) 60%, rgba(251,146,60,.4) 85%, transparent 100%);">
                </div>

                {# Blob 7 #}
                <div class="absolute opacity-65 blur-[95px]"
                     style="top:25%; left:50%; width:135%; height:135%;
                            background: radial-gradient(circle at center, rgba(249,115,22,.8) 0%, rgba(253,224,71,.7) 25%, rgba(251,146,60,.6) 50%, rgba(236,72,153,.4) 80%, transparent 100%);">
                </div>

                {# Blob 8 #}
                <div class="absolute opacity-60 blur-[110px]"
                     style="top:66%; right:50%; width:125%; height:125%;
                            background: radial-gradient(circle at center, rgba(139,92,246,.7) 0%, rgba(168,85,247,.6) 30%, rgba(236,72,153,.5) 55%, rgba(251,146,60,.6) 80%, transparent 100%);">
                </div>

                {# Blob 9 #}
                <div class="absolute opacity-70 blur-[120px]"
                     style="bottom:50%; right:25%; width:115%; height:115%;
                            background: radial-gradient(ellipse at center, rgba(253,224,71,.75) 0%, rgba(251,191,36,.65) 35%, rgba(251,146,60,.55) 65%, transparent 100%);">
                </div>

            {% endif %}

        {% endif %}

        {# Subtle overlay #}
        <div class="absolute inset-0 bg-white/5"></div>
    </div>

    {# Hero content #}
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 {{ isLeft ? 'text-left' : 'text-center' }}">
        <div class="hero-default-content space-y-6">

            {% if content.back_link_text|default %}
                <div class="{{ isLeft ? '' : 'flex justify-center' }}">
                    <a href="{{ content.back_link_url|default('#') }}"
                       class="inline-flex items-center space-x-2 text-white/90 hover:text-white transition-colors group">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="w-5 h-5 group-hover:-translate-x-1 transition-transform">
                            <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
                        </svg>
                        <span class="font-semibold">{{ content.back_link_text }}</span>
                    </a>
                </div>
            {% endif %}

            {% if content.mini_title|default %}
                <div class="{{ isLeft ? '' : 'flex justify-center' }}">
                    <span class="inline-flex items-center px-4 py-2 bg-white/20 backdrop-blur-sm text-white rounded-full text-sm font-semibold">
                        {{ content.mini_title }}
                    </span>
                </div>
            {% endif %}

            {% if content.title|default %}
                {% set titleParts = content.title|split('|') %}
                <h1 class="text-5xl md:text-7xl font-bold text-white">
                    {{ titleParts[0] }}{% if titleParts[1] is defined %}<sup class="text-2xl md:text-4xl font-normal align-super ml-1 ml-1 -top-1 md:-top-1 lg:-top-2">{{ titleParts[1] }}</sup>{% endif %}
                </h1>
            {% endif %}

            {% if content.description|default %}
                <div class="text-xl md:text-2xl text-white/90 {{ isLeft ? 'max-w-2xl' : 'max-w-3xl mx-auto' }}">
                    {{ content.description|raw }}
                </div>
            {% endif %}

            {% if content.button_text|default or content.button_text2|default %}
                <div class="flex flex-col sm:flex-row gap-4 pt-2 {{ isLeft ? 'justify-start' : 'justify-center' }}">

                    {% if content.button_text|default %}
                        <a href="{{ content.button_link|default('#') }}"
                           class="hero-default-btn-primary group px-6 py-3.5 md:px-8 md:py-4 bg-white text-gray-900 rounded-full font-semibold transition-all duration-300 flex items-center justify-center space-x-2 min-h-[44px] text-[15px] md:text-base">
                            <span>{{ content.button_text }}</span>
                            <div class="relative w-[18px] h-[18px] md:w-5 md:h-5">
                                <svg class="icon-chevron absolute inset-0 w-[18px] h-[18px] md:w-5 md:h-5"
                                     xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"/>
                                </svg>
                                <svg class="icon-arrow absolute inset-0 w-[18px] h-[18px] md:w-5 md:h-5"
                                     xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                                </svg>
                            </div>
                        </a>
                    {% endif %}

                    {% if content.button_text2|default %}
                        <a href="{{ content.button_link2|default('#') }}"
                           class="inline-flex items-center justify-center px-6 py-3.5 md:px-8 md:py-4 bg-white/10 backdrop-blur-sm text-white border-1 border-white/30 rounded-full font-semibold hover:bg-white/20 transition-all duration-300">
                            {{ content.button_text2 }}
                        </a>
                    {% endif %}

                </div>
            {% endif %}

            {% if content.bullets|default %}
                <div class="flex flex-wrap gap-6 text-white/90 text-base md:text-lg {{ isLeft ? '' : 'justify-center' }}">
                    {% for bullet in content.bullets %}
                        <div class="flex items-center space-x-2">
                            {% if bullet.icon|default %}
                                <img src="{{ bullet.icon.url }}" alt="{{ bullet.icon.title|default('') }}"
                                     class="w-5 h-5 object-contain brightness-0 invert shrink-0">
                            {% endif %}
                            {% if bullet.text|default %}
                                <span>{{ bullet.text }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </div>

</section>

</div>
