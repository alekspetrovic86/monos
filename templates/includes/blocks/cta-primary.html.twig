            </div>
            <div class="absolute opacity-60 blur-[130px]"
                 style="bottom:33%; right:33%; width:170%; height:170%;
                        background: {{ {'6':'radial-gradient(ellipse at center, rgba(79,70,229,.75) 0%, rgba(99,102,241,.6) 35%, rgba(139,92,246,.45) 65%, rgba(168,85,247,.3) 90%, transparent 100%)','7':'radial-gradient(ellipse at center, rgba(126,34,206,.75) 0%, rgba(147,51,234,.6) 35%, rgba(236,72,153,.45) 65%, rgba(168,85,247,.3) 90%, transparent 100%)','8':'radial-gradient(ellipse at center, rgba(245,158,11,.75) 0%, rgba(253,224,71,.6) 35%, rgba(251,146,60,.45) 65%, rgba(249,115,22,.3) 90%, transparent 100%)','9':'radial-gradient(ellipse at center, rgba(219,39,119,.75) 0%, rgba(249,115,22,.6) 35%, rgba(244,114,182,.45) 65%, rgba(251,146,60,.3) 90%, transparent 100%)','10':'radial-gradient(ellipse at center, rgba(79,70,229,.75) 0%, rgba(236,72,153,.6) 35%, rgba(249,115,22,.45) 65%, rgba(251,191,36,.3) 90%, transparent 100%)'}[variant] }};">
