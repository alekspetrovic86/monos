                 style="top:-50%; right:-33%; width:200%; height:200%;
                        background: radial-gradient(circle at center, rgba(139,92,246,.85) 0%, rgba(236,72,153,.75) 25%, rgba(249,115,22,.6) 50%, rgba(251,191,36,.4) 75%, transparent 100%);">
            </div>
            <div class="absolute opacity-65 blur-[110px]"
                 style="bottom:-33%; left:-25%; width:180%; height:180%;
                        background: radial-gradient(ellipse at center, rgba(236,72,153,.8) 0%, rgba(249,115,22,.65) 30%, rgba(168,85,247,.5) 60%, rgba(251,191,36,.3) 85%, transparent 100%);">
            </div>
            <div class="absolute opacity-80 blur-[115px]"
