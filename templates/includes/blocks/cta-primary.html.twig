            </div>
            <div class="absolute opacity-65 blur-[95px]"
                 style="top:25%; left:50%; width:135%; height:135%;
                        background: {{ {'6':'radial-gradient(circle at center, rgba(139,92,246,.8) 0%, rgba(99,102,241,.7) 25%, rgba(168,85,247,.6) 50%, rgba(79,70,229,.4) 80%, transparent 100%)','7':'radial-gradient(circle at center, rgba(219,39,119,.8) 0%, rgba(147,51,234,.7) 25%, rgba(244,114,182,.6) 50%, rgba(168,85,247,.4) 80%, transparent 100%)','8':'radial-gradient(circle at center, rgba(245,158,11,.8) 0%, rgba(253,224,71,.7) 25%, rgba(249,115,22,.6) 50%, rgba(251,191,36,.4) 80%, transparent 100%)','9':'radial-gradient(circle at center, rgba(219,39,119,.8) 0%, rgba(251,191,36,.7) 25%, rgba(249,115,22,.6) 50%, rgba(244,114,182,.4) 80%, transparent 100%)','10':'radial-gradient(circle at center, rgba(249,115,22,.8) 0%, rgba(139,92,246,.7) 25%, rgba(236,72,153,.6) 50%, rgba(251,191,36,.4) 80%, transparent 100%)'}[variant] }};">
