                     style="top:50%; left:25%; width:150%; height:150%;
                            background: radial-gradient(circle at center, rgba(251,191,36,.85) 0%, rgba(253,224,71,.7) 30%, rgba(236,72,153,.55) 60%, rgba(139,92,246,.35) 85%, transparent 100%);">
