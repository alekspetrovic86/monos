                        background: {{ {'6':'radial-gradient(circle at center, rgba(79,70,229,.7) 0%, rgba(139,92,246,.6) 30%, rgba(99,102,241,.5) 55%, rgba(168,85,247,.6) 80%, transparent 100%)','7':'radial-gradient(circle at center, rgba(168,85,247,.7) 0%, rgba(236,72,153,.6) 30%, rgba(147,51,234,.5) 55%, rgba(219,39,119,.6) 80%, transparent 100%)','8':'radial-gradient(circle at center, rgba(251,146,60,.7) 0%, rgba(249,115,22,.6) 30%, rgba(251,191,36,.5) 55%, rgba(245,158,11,.6) 80%, transparent 100%)','9':'radial-gradient(circle at center, rgba(251,146,60,.7) 0%, rgba(219,39,119,.6) 30%, rgba(249,115,22,.5) 55%, rgba(244,114,182,.6) 80%, transparent 100%)','10':'radial-gradient(circle at center, rgba(168,85,247,.7) 0%, rgba(251,191,36,.6) 30%, rgba(249,115,22,.5) 55%, rgba(79,70,229,.6) 80%, transparent 100%)'}[variant] }};">
            </div>
            <div class="absolute opacity-70 blur-[120px]"
                 style="bottom:50%; right:25%; width:115%; height:115%;
                        background: {{ {'6':'radial-gradient(ellipse at center, rgba(168,85,247,.75) 0%, rgba(99,102,241,.65) 35%, rgba(139,92,246,.55) 65%, transparent 100%)','7':'radial-gradient(ellipse at center, rgba(244,114,182,.75) 0%, rgba(168,85,247,.65) 35%, rgba(219,39,119,.55) 65%, transparent 100%)','8':'radial-gradient(ellipse at center, rgba(253,224,71,.75) 0%, rgba(251,191,36,.65) 35%, rgba(245,158,11,.55) 65%, transparent 100%)','9':'radial-gradient(ellipse at center, rgba(244,114,182,.75) 0%, rgba(251,191,36,.65) 35%, rgba(249,115,22,.55) 65%, transparent 100%)','10':'radial-gradient(ellipse at center, rgba(253,224,71,.75) 0%, rgba(236,72,153,.65) 35%, rgba(139,92,246,.55) 65%, transparent 100%)'}[variant] }};">
