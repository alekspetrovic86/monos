{# CTA PRIMARY #}

{% set mode    = content.mode|default('light') %}
{% set variant = content.bg_variant|default('3') %}

<div data-mode-block="{{ mode }}">

{# ── DARK VERSION ────────────────────────────────────────────────────── #}

<section data-theme-version="dark" {{ mode != 'dark' ? 'style="display:none"' : '' }} class="cta-primary-dark relative py-16 md:py-28 lg:py-32 overflow-hidden bg-black xl:border-t xl:border-grey-700">

    {# Content #}
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8">

        {# Glassmorphic card #}
        <div class="relative rounded-3xl p-8 md:p-12 lg:p-16 text-center"
             style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);box-shadow:0 8px 32px 0 rgba(0,0,0,.37),inset 0 1px 1px 0 rgba(255,255,255,.05);">

            <div class="space-y-6">

                {% if content.title|default %}
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-1.2px] leading-[1.1] text-white">
                        {{ content.title }}
                    </h2>
                {% endif %}

                {% if content.description|default %}
                    <div class="text-xl md:text-2xl lg:text-[21px] lg:tracking-[0.2px] text-grey-450 leading-[1.38] max-w-3xl mx-auto">
                        {{ content.description|raw }}
                    </div>
                {% endif %}

                {% if content.button_text|default or content.button_text2|default %}
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4 pt-4">

                        {% if content.button_text|default %}
                            <a href="{{ content.button_link|default('#') }}"
                               class="cta-dark-btn-primary group inline-flex items-center justify-center space-x-2 px-6 py-3.5 md:px-8 md:py-4 bg-white text-dark-800 rounded-full font-semibold transition-all duration-300 min-h-[44px] text-[15px] md:text-base w-full sm:w-auto hover:bg-white/90">
                                <span>{{ content.button_text }}</span>
                                <div class="relative w-4 h-4 md:w-[18px] md:h-[18px]">
                                    <svg class="icon-chevron absolute inset-0 w-4 h-4 md:w-[18px] md:h-[18px]"
                                         xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"/>
                                    </svg>
                                    <svg class="icon-arrow absolute inset-0 w-4 h-4 md:w-[18px] md:h-[18px]"
                                         xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </div>
                            </a>
                        {% endif %}

                        {% if content.button_text2|default %}
                            <a href="{{ content.button_link2|default('#') }}"
                               class="inline-flex items-center justify-center px-6 py-3.5 md:px-8 md:py-4 bg-white/10 backdrop-blur-sm text-white rounded-full border border-white/20 hover:bg-white/15 hover:border-white/30 transition-all duration-300 min-h-[44px] text-[15px] md:text-base font-semibold w-full sm:w-auto">
                                {{ content.button_text2 }}
                            </a>
                        {% endif %}

                    </div>
                {% endif %}

            </div>
        </div>
    </div>

</section>

{# ── LIGHT VERSION ───────────────────────────────────────────────────── #}

<section data-theme-version="light" {{ mode != 'light' ? 'style="display:none"' : '' }} class="cta-primary relative py-16 md:py-28 lg:py-32 overflow-hidden">

    {# Static Gradient Background #}
    <div class="cta-primary-bg-container absolute inset-0 overflow-hidden {{ variant == '5' ? 'cta-bg--v5' : 'bg-surface' }}">

        {# ── Variant 5: dark warm base + overlay ── #}
        {% if variant == '5' %}

            <div class="cta-bg-base cta-bg-base--v5 absolute inset-0 opacity-70"></div>

            <div class="absolute opacity-70 blur-[120px]"
                 style="top:-20%; left:-10%; width:160%; height:160%;
                        background: radial-gradient(circle at center, rgba(251,191,36,.7) 0%, rgba(236,72,153,.5) 50%, transparent 100%);">
            </div>
            <div class="absolute opacity-60 blur-[130px]"
                 style="bottom:-20%; right:-10%; width:160%; height:160%;
                        background: radial-gradient(ellipse at center, rgba(99,102,241,.6) 0%, rgba(139,92,246,.45) 40%, rgba(236,72,153,.3) 70%, transparent 100%);">
            </div>

        {# ── Variant 4: warm base ── #}
        {% elseif variant == '4' %}

            <div class="cta-bg-base cta-bg-base--v4 absolute inset-0 opacity-80"></div>

            <div class="absolute opacity-75 blur-[120px]"
                 style="top:-50%; right:-33%; width:200%; height:200%;
                        background: radial-gradient(circle at center, rgba(236,72,153,.85) 0%, rgba(249,115,22,.75) 25%, rgba(251,191,36,.6) 50%, rgba(253,224,71,.4) 75%, transparent 100%);">
            </div>
