{# HEADER #}

{# Build active language and localized URLs #}
{% set currentLocale = app.request.locale|split('_')[0] %}
{% set langMap      = {'sr': 'SR', 'en': 'EN', 'de': 'DE', 'ja': 'JA'} %}
{% set activeLangMap = {'sr': 'SR', 'en': 'EN', 'de': 'DE', 'ja': '日'} %}
{% set mobileLanguageLabelMap = {'sr': 'Jezik', 'en': 'Language', 'de': 'Sprache', 'ja': '言語'} %}
{% set mobileLangMapByLocale = {
    'sr': langMap,
    'en': langMap,
    'de': langMap,
    'ja': {'sr': 'セル', 'en': '英', 'de': '独', 'ja': '日'}
} %}
{% set currentLangLabel = activeLangMap[currentLocale] ?? langMap[currentLocale] ?? currentLocale|upper %}
{% set mobileLanguageLabel = mobileLanguageLabelMap[currentLocale] ?? 'Language' %}
{% set mobileLangMap = mobileLangMapByLocale[currentLocale] ?? langMap %}
{% set navItems = sulu_navigation_root_tree('main', 2, true) %}
{% set navMode = webspaceSettings.content.header_mode|default('light') %}
{% set navIsDark = navMode == 'dark' %}

<div data-controller="navbar" data-nav-theme="{{ navIsDark ? 'dark' : 'light' }}">
<nav
    id="navbar"
    data-navbar-target="navbar"
    class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl border-b transition-[height] duration-300 ease-in-out"
    style="height: var(--height-navbar); background-color: {{ navIsDark ? 'rgba(0,0,0,0.65)' : 'var(--color-navbar-bg)' }}; border-color: {{ navIsDark ? 'rgba(255,255,255,0.08)' : 'var(--color-navbar-border)' }}; box-shadow: {{ navIsDark ? 'none' : 'var(--color-navbar-shadow)' }};"
>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 h-full">
        <div class="flex items-center" style="height: 80px;">

            {# Logo #}
            <a href="{{ sulu_content_path('/') }}" class="flex items-center space-x-2">
                <span class="navbar-logo font-bold text-2xl tracking-tight transition-all duration-500 {{ navIsDark ? 'text-white' : 'bg-gradient-to-r from-dark-800 to-dark-700 bg-clip-text text-transparent' }}">
                    Monos
                </span>
            </a>

            {# Desktop navigation #}
            <div class="hidden xl:flex items-center space-x-1 ml-10">

                {% for item in navItems %}
                    {% set itemUrl = sulu_content_path(item.url, item.webspaceKey) %}
                    {% set isActive = sulu_navigation_is_active(request.resourceLocator, item.url) %}
                    {% set hasChildren = item.children|default([])|length > 0 %}

                    {% if hasChildren %}
                        <div id="services-wrapper" data-navbar-target="desktopHoverTrigger" class="group/services relative flex items-center">
                            <a href="{{ itemUrl }}"
                               class="nav-link {{ isActive ? 'is-active' : '' }} pl-4 pr-1 py-2 rounded-lg transition-all duration-300 font-medium {{ navIsDark ? (isActive ? 'text-white' : 'text-white/80 hover:text-white') : (isActive ? 'text-dark-800' : 'text-dark-500 hover:text-dark-800') }}">
                                {{ item.title }}
                            </a>
                            <button type="button"
                                    data-action="click->navbar#toggleDesktopDropdown"
                                    class="nav-dropdown-arrow-btn py-2 pr-3 pl-0.5 cursor-pointer {{ navIsDark ? 'text-white/80' : 'text-dark-500' }}">
                                <svg class="desktop-dropdown-chevron transition-transform duration-200 group-hover/services:rotate-180"
                                     xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"/>
                                </svg>
                            </button>

                            <div class="desktop-dropdown absolute left-0 top-full pt-6 pb-2 pl-14 invisible opacity-0 group-hover/services:visible group-hover/services:opacity-100 transition-all duration-300">
                                <div class="flex items-center space-x-6">
                                    {% for child in item.children %}
                                        {% set childUrl = sulu_content_path(child.url, child.webspaceKey) %}
                                        {% set isActiveChild = sulu_navigation_is_active(request.resourceLocator, child.url) ? true : false %}
                                        <a href="{{ childUrl }}"
                                           class="nav-dropdown-link {{ isActiveChild ? 'is-active' : '' }} transition-all duration-300 font-medium whitespace-nowrap {{ navIsDark ? (isActiveChild ? 'text-white' : 'text-white/80 hover:text-white') : (isActiveChild ? 'text-dark-800' : 'text-dark-500 hover:text-dark-800') }}">
                                            {% if child.excerpt.title is defined and child.excerpt.title %}
                                                {{ child.title|slice(0, child.title|length - child.excerpt.title|length)|trim }}<sup class="text-[10px] ml-0.5">{{ child.excerpt.title }}</sup>
                                            {% else %}
                                                {{ child.title }}
                                            {% endif %}
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ itemUrl }}"
                           class="nav-link {{ isActive ? 'is-active' : '' }} px-4 py-2 rounded-lg transition-all duration-300 font-medium {{ navIsDark ? (isActive ? 'text-white' : 'text-white/80 hover:text-white') : (isActive ? 'text-dark-800' : 'text-dark-500 hover:text-dark-800') }}">
                            {{ item.title }}
                        </a>
                    {% endif %}
                {% endfor %}

            </div>

            {# Right side #}
            <div class="flex items-center ml-auto space-x-2">

                {# Language switcher (desktop) #}
                <div id="lang-wrapper" data-navbar-target="desktopHoverTrigger" class="group/lang hidden xl:block relative">
                    <a data-action="click->navbar#toggleDesktopDropdown"
                       class="navbar-lang-btn px-3 py-2 rounded-lg transition-all duration-300 font-medium flex items-center space-x-1 {{ navIsDark ? 'text-white/80 group-hover/lang:text-white' : 'text-dark-500 group-hover/lang:text-dark-800' }} cursor-pointer select-none">
                        <span>{{ currentLangLabel }}</span>
                        <svg class="desktop-dropdown-chevron transition-transform duration-200 group-hover/lang:rotate-180"
                             xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </a>

                    <div class="desktop-dropdown absolute top-full pt-6 pb-2 right-[30px] invisible opacity-0 group-hover/lang:visible group-hover/lang:opacity-100 transition-all duration-300">
                        <div class="flex items-center space-x-6">
                            {% for localization in localizations %}
                                {% if localization.locale not in webspaceSettings.content.hide_languages|default([]) %}
                                    {% if localization.locale != app.request.locale %}
                                        {% set localeCode = localization.locale|split('_')[0] %}
                                        <a href="{{ localization.url }}"
                                        class="navbar-lang-link transition-all duration-300 font-medium whitespace-nowrap {{ navIsDark ? 'text-white/80 hover:text-white' : 'text-dark-500 hover:text-dark-800' }}">
                                            {{ ('lang.' ~ localeCode)|trans }}
                                        </a>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# Theme toggle — only shown when enabled in snippet #}
                {% if webspaceSettings.content.show_theme_toggle|default(false) and not webspaceSettings.content.auto_theme_by_time|default(false) %}
                <button data-action="click->theme#toggle"
                        class="theme-toggle {{ navIsDark ? 'cms-dark' : '' }} p-2 rounded-lg cursor-pointer {{ navIsDark ? 'text-white' : 'text-dark-800' }}"
                        aria-label="Toggle theme">
                    <svg class="icon-theme-symbol w-[22px] h-[22px]"
                         xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"
                         aria-hidden="true">
                        <circle cx="16" cy="16" r="11.5" />
                        <path d="M16 4.5A11.5 11.5 0 0 1 16 27.5Z" fill="currentColor" stroke="none" />
                    </svg>
                </button>
                {% endif %}

                {# Hamburger (mobile) #}
                <button data-action="click->navbar#toggleMobile"
                        class="navbar-hamburger xl:hidden p-2 rounded-lg transition-all duration-300 {{ navIsDark ? 'text-white hover:bg-white/10' : 'text-dark-800 hover:bg-grey-100' }} inline-flex items-center"
                        aria-label="Toggle menu">
                    <svg data-navbar-target="hamburgerIcon"
                         xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" x2="20" y1="12" y2="12"/>
                        <line x1="4" x2="20" y1="6" y2="6"/>
                        <line x1="4" x2="20" y1="18" y2="18"/>
                    </svg>
                    <svg data-navbar-target="closeIcon"
                         xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>

            </div>
        </div>
    </div>
</nav>

{# ── MOBILE MENU ─────────────────────────────────────────────────── #}

<div id="mobile-menu"
     data-navbar-target="mobileMenu"
     data-navbar-mobile-open-value="false"
     class="fixed left-0 right-0 bottom-0 z-[60] xl:hidden overflow-y-auto"
     {% if navIsDark %}
     style="top: var(--height-navbar); background-color: #000000;"
     {% else %}
     style="top: var(--height-navbar); background-color: #ffffff; background-image: linear-gradient(135deg, color-mix(in srgb, var(--color-violet-500) 5%, transparent) 0%, color-mix(in srgb, var(--color-pink-500) 5%, transparent) 50%, color-mix(in srgb, var(--color-orange-500) 5%, transparent) 100%); background-blend-mode: overlay;"
     {% endif %}>
    <div class="min-h-full px-8 py-12 flex flex-col">

        <nav class="flex-1 space-y-2">

            {% for item in navItems %}
                {% set itemUrl = sulu_content_path(item.url, item.webspaceKey) %}
                {% set isActive = sulu_navigation_is_active(request.resourceLocator, item.url) %}
                {% set hasChildren = item.children|default([])|length > 0 %}

                {% if hasChildren %}
                    <div>
                        <div class="flex items-center justify-between py-4">
                            <a href="{{ itemUrl }}"
                               data-action="click->navbar#closeMobile"
                               class="navbar-mobile-link {{ isActive ? 'is-active' : '' }} text-xl font-semibold transition-colors flex-1 {{ navIsDark ? (isActive ? 'text-white' : 'text-white/80 hover:text-white') : (isActive ? 'text-dark-800' : 'text-dark-500 hover:text-dark-800') }}">
                                {{ item.title }}
                            </a>
                            <button data-action="click->navbar#toggleMobileServices" class="p-2 -mr-2">
                                <svg data-navbar-target="mobileServicesChevron"
                                     class="navbar-chevron {{ navIsDark ? 'text-white/60' : 'text-dark-500' }}"
                                     xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"/>
                                </svg>
                            </button>
                        </div>
                        <div data-navbar-target="mobileServicesContent" class="accordion-content">
                            <div class="pl-6 space-y-1 pb-2">
                                {% for child in item.children %}
                                    {% set childUrl = sulu_content_path(child.url, child.webspaceKey) %}
                                    {% set isActiveChild = sulu_navigation_is_active(request.resourceLocator, child.url) ? true : false %}
                                    <a href="{{ childUrl }}"
                                       data-action="click->navbar#closeMobile"
                                       class="navbar-mobile-child-link {{ isActiveChild ? 'is-active' : '' }} block py-3 text-base font-medium transition-colors {{ navIsDark ? (isActiveChild ? 'text-white' : 'text-white/70 hover:text-white') : (isActiveChild ? 'text-dark-800' : 'text-dark-500 hover:text-dark-800') }}">
                                        {% if child.excerpt.title is defined and child.excerpt.title %}
                                            {{ child.title|slice(0, child.title|length - child.excerpt.title|length)|trim }}<sup class="text-[10px] ml-0.5">{{ child.excerpt.title }}</sup>
                                        {% else %}
                                            {{ child.title }}
                                        {% endif %}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ itemUrl }}"
                       data-action="click->navbar#closeMobile"
                       class="navbar-mobile-link {{ isActive ? 'is-active' : '' }} block py-4 text-xl font-semibold transition-colors {{ navIsDark ? (isActive ? 'text-white' : 'text-white/80 hover:text-white') : (isActive ? 'text-dark-800' : 'text-dark-500 hover:text-dark-800') }}">
                        {{ item.title }}
                    </a>
                {% endif %}
            {% endfor %}

        </nav>

        {# Bottom: language + CTA #}
        <div class="navbar-mobile-bottom mt-auto pt-8 border-t {{ navIsDark ? 'border-grey-700' : 'border-grey-200' }}">

            <button data-action="click->navbar#toggleMobileLang"
                    class="flex items-center justify-between w-full py-3">
                <span class="navbar-mobile-lang-label text-sm font-semibold {{ navIsDark ? 'text-white/50' : 'text-grey-500' }} uppercase tracking-wide">
                    {{ mobileLanguageLabel }}: {{ currentLangLabel }}
                </span>
                <svg data-navbar-target="mobileLangChevron"
                     class="navbar-chevron {{ navIsDark ? 'text-white/50' : 'text-grey-500' }}"
                     xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </button>

            <div data-navbar-target="mobileLangContent" class="accordion-content">
                <div class="grid grid-cols-4 gap-2 py-4">
                    {% for localization in localizations %}
                        {% if localization.locale not in webspaceSettings.content.hide_languages|default([]) %}
                            {% set localeCode = localization.locale|split('_')[0] %}
                            {% set localeLabel = mobileLangMap[localeCode] ?? langMap[localeCode] ?? localeCode|upper %}
                            {% set isCurrentLocale = (localeCode == currentLocale) %}
                            <a href="{{ localization.url }}"
                               class="navbar-mobile-locale {{ isCurrentLocale ? 'is-current' : '' }} py-3 rounded-full text-sm font-semibold text-center transition-all {{ navIsDark ? (isCurrentLocale ? 'bg-white text-dark-800' : 'bg-white/10 text-white/70 active:bg-white/20') : (isCurrentLocale ? 'bg-dark-800 text-white' : 'bg-white/60 text-dark-600 active:bg-white') }}">
                                {{ localeLabel }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {% if webspaceSettings.content.header_button_text|default %}
            <a href="{{ webspaceSettings.content.header_button_link|default('#') }}"
               data-action="click->navbar#closeMobile"
               class="navbar-mobile-cta block w-full py-4 {{ navIsDark ? 'bg-white text-dark-800 active:bg-grey-100' : 'bg-dark-800 text-white active:bg-dark-700' }} text-center rounded-full font-semibold text-lg mt-6 transition-colors">
                {{ webspaceSettings.content.header_button_text }}
            </a>
            {% endif %}
        </div>
    </div>
</div>
</div>{# end data-controller="navbar" #}
