{# COOKIE CONSENT #}
{% set ccLocale = app.request.locale|split('_')[0] %}

<div data-controller="cookie-consent" class="cc-root">

    {# ── Banner ───────────────────────────────────────────────────────────── #}
    <div class="cc-banner" data-cookie-consent-target="banner" aria-hidden="true" role="region" aria-label="Cookie consent">
        <div class="cc-banner-inner max-w-7xl mx-auto px-6 lg:px-8">
            <p class="cc-banner-text">{{ 'cc.banner_text'|trans({}, 'messages', ccLocale) }}</p>
            <div class="cc-banner-actions">
                <button type="button" class="cc-btn cc-btn--ghost"
                        data-action="click->cookie-consent#openSettings">
                    {{ 'cc.settings'|trans({}, 'messages', ccLocale) }}
                </button>
                <button type="button" class="cc-btn cc-btn--secondary"
                        data-action="click->cookie-consent#rejectAll">
                    {{ 'cc.reject_all'|trans({}, 'messages', ccLocale) }}
                </button>
                <button type="button" class="cc-btn cc-btn--primary"
                        data-action="click->cookie-consent#acceptAll">
                    {{ 'cc.accept_all'|trans({}, 'messages', ccLocale) }}
                </button>
            </div>
        </div>
    </div>

    {# ── Backdrop ─────────────────────────────────────────────────────────── #}
    <div class="cc-backdrop"
         data-cookie-consent-target="backdrop"
         data-action="click->cookie-consent#closeSettings"
         aria-hidden="true"></div>

    {# ── Modal ────────────────────────────────────────────────────────────── #}
    <div class="cc-modal"
         data-cookie-consent-target="modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="cc-modal-title"
         aria-hidden="true">
        <div class="cc-modal-inner">

            <div class="cc-modal-header">
                <h2 id="cc-modal-title" class="cc-modal-title">
                    {{ 'cc.modal_title'|trans({}, 'messages', ccLocale) }}
                </h2>
                <button type="button" class="cc-modal-close"
                        data-action="click->cookie-consent#closeSettings"
                        aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <div class="cc-modal-body">

                {# Necessary — always on #}
                <div class="cc-category">
                    <div class="cc-category-header">
                        <h3 class="cc-category-title">{{ 'cc.necessary'|trans({}, 'messages', ccLocale) }}</h3>
                        <span class="cc-always-active">{{ 'cc.always_active'|trans({}, 'messages', ccLocale) }}</span>
                    </div>
                    <p class="cc-category-desc">{{ 'cc.necessary_desc'|trans({}, 'messages', ccLocale) }}</p>
                </div>

                {# Analytics #}
                <div class="cc-category">
                    <div class="cc-category-header">
                        <h3 class="cc-category-title">{{ 'cc.analytics'|trans({}, 'messages', ccLocale) }}</h3>
                        <label class="cc-toggle" aria-label="{{ 'cc.analytics'|trans({}, 'messages', ccLocale) }}">
                            <input type="checkbox" data-cookie-consent-target="analyticsToggle">
                            <span class="cc-toggle-track"><span class="cc-toggle-thumb"></span></span>
                        </label>
                    </div>
                    <p class="cc-category-desc">{{ 'cc.analytics_desc'|trans({}, 'messages', ccLocale) }}</p>
                </div>

                {# Marketing #}
                <div class="cc-category">
                    <div class="cc-category-header">
                        <h3 class="cc-category-title">{{ 'cc.marketing'|trans({}, 'messages', ccLocale) }}</h3>
                        <label class="cc-toggle" aria-label="{{ 'cc.marketing'|trans({}, 'messages', ccLocale) }}">
                            <input type="checkbox" data-cookie-consent-target="marketingToggle">
                            <span class="cc-toggle-track"><span class="cc-toggle-thumb"></span></span>
                        </label>
                    </div>
                    <p class="cc-category-desc">{{ 'cc.marketing_desc'|trans({}, 'messages', ccLocale) }}</p>
                </div>

            </div>

            <div class="cc-modal-footer">
                <button type="button" class="cc-btn cc-btn--ghost"
                        data-action="click->cookie-consent#rejectAll">
                    {{ 'cc.reject_all'|trans({}, 'messages', ccLocale) }}
                </button>
                <button type="button" class="cc-btn cc-btn--secondary"
                        data-action="click->cookie-consent#saveSettings">
                    {{ 'cc.save'|trans({}, 'messages', ccLocale) }}
                </button>
                <button type="button" class="cc-btn cc-btn--primary"
                        data-action="click->cookie-consent#acceptAll">
                    {{ 'cc.accept_all'|trans({}, 'messages', ccLocale) }}
                </button>
            </div>

        </div>
    </div>

</div>
