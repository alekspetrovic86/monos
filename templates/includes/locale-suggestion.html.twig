{% set localeSuggestionLocale = app.request.locale|split('_')[0] %}
{% set localeSuggestionLabels = {
    'sr': 'lang.sr'|trans({}, 'messages', localeSuggestionLocale),
    'en': 'lang.en'|trans({}, 'messages', localeSuggestionLocale),
    'de': 'lang.de'|trans({}, 'messages', localeSuggestionLocale),
    'ja': 'lang.ja'|trans({}, 'messages', localeSuggestionLocale)
} %}

<div
    data-controller="locale-suggestion"
    data-locale-suggestion-current-locale-value="{{ localeSuggestionLocale }}"
    data-locale-suggestion-localizations-value="{{ localizations|default([])|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}"
    data-locale-suggestion-locale-labels-value="{{ localeSuggestionLabels|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}"
    data-locale-suggestion-text-template-value="{{ 'geo_popup.text'|trans({'%locale%': '__LOCALE__'}, 'messages', localeSuggestionLocale)|e('html_attr') }}"
    data-locale-suggestion-accept-template-value="{{ 'geo_popup.accept'|trans({'%locale%': '__LOCALE__'}, 'messages', localeSuggestionLocale)|e('html_attr') }}"
    data-locale-suggestion-endpoint-value="https://api.country.is/"
    class="ls-root"
>
    <div class="ls-backdrop"
         data-locale-suggestion-target="backdrop"
         data-action="click->locale-suggestion#dismiss"
         aria-hidden="true"></div>

    <aside class="ls-popup"
           data-locale-suggestion-target="popup"
           role="dialog"
           aria-modal="true"
           aria-labelledby="ls-title"
           aria-hidden="true">
        <button type="button"
                class="ls-close"
                data-action="click->locale-suggestion#dismiss"
                aria-label="Close">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>

        <div class="ls-content">
            <h2 id="ls-title" class="ls-title">{{ 'geo_popup.title'|trans({}, 'messages', localeSuggestionLocale) }}</h2>
            <p class="ls-text" data-locale-suggestion-target="text">{{ 'geo_popup.text'|trans({'%locale%': ''}, 'messages', localeSuggestionLocale)|trim }}</p>

            <div class="ls-actions">
                <button type="button"
                        class="cc-btn cc-btn--ghost"
                        data-action="click->locale-suggestion#dismiss">
                    {{ 'geo_popup.dismiss'|trans({}, 'messages', localeSuggestionLocale) }}
                </button>
                <a href="#"
                   class="cc-btn cc-btn--primary"
                   data-locale-suggestion-target="switchLink"
                   data-action="click->locale-suggestion#accept">
                    {{ 'geo_popup.accept'|trans({'%locale%': ''}, 'messages', localeSuggestionLocale)|trim }}
                </a>
            </div>
        </div>
    </aside>
</div>